src/coverage/loader/ExcelJSConfigLoader.ts

What changed: Column names updated to match actual Excel screenshot. Added parsing for Form Number, Form Order, Formset columns. Added grid type parsing (extracts columns and row count from complex type strings). Added formSetName derivation from Formset column.

typescript
import { Workbook }      from 'exceljs';
import type {
  Cell,
  Row,
  CellRichTextValue,
  CellFormulaValue,
  CellHyperlinkValue,
} from 'exceljs';
import {
  FormSetConfig,
  FormConfig,
  FormFieldConfig,
  FieldType,
  GridConfig,
} from '../types/coverage.types';
import { Logger } from '../../utils/LoggerUtils';

/**
 * Column header names — must match your Excel file exactly (case-sensitive).
 *
 * FROM ACTUAL SCREENSHOT:
 *   Column A: Product
 *   Column B: Sub Segment
 *   Column C: Formset
 *   Column D: Form Number  (UUID like '3C0801C89D74121688825773700SFA-C72')
 *   Column E: Form Name    (readable: 'DEDUCTIBLE CLAUSE ENDORSEMENT')
 *   Column F: Form ID      (code: 'IM 8012 01 10')
 *   Column G: Form Order
 *   Column H: Category     (Optional / Mandatory)
 *   Column I: States Applicable
 *   Column J: Field
 *   Column K: Type         (Text, Grid [Columns:...][Rows...])
 *   Column L: Required     (Yes / No)
 *   Column M: Mapping
 *
 * Typed as Record<string, string> — NOT as const.
 * 'as const' causes TypeScript literal-type indexing errors in strict mode.
 */
const COL: Record<string, string> = {
  PRODUCT:           'Product',
  SUB_SEGMENT:       'Sub Segment',
  FORMSET:           'Formset',
  FORM_NUMBER:       'Form Number',
  FORM_NAME:         'Form Name',
  FORM_ID:           'Form ID',
  FORM_ORDER:        'Form Order',
  CATEGORY:          'Category',
  STATES_APPLICABLE: 'States Applicable',
  FIELD:             'Field',
  TYPE:              'Type',
  REQUIRED:          'Required',
  MAPPING:           'Mapping',
  FIELD_SELECTOR:    'Field Selector',   // optional — recommended column
};

/**
 * Required columns that MUST exist in the Excel file.
 * Typed as string[] — NOT as const.
 */
const REQUIRED_COLUMNS: string[] = [
  'Product',
  'Sub Segment',
  'Formset',
  'Form Name',
  'Form ID',
  'Category',
  'Field',
  'Type',
  'Required',
  'Mapping',
];

export class ExcelJSConfigLoader {

  /**
   * Reads the Excel file and returns all FormSetConfigs.
   * Called by FormRegistry — cached after first call.
   */
  static async load(filePath: string): Promise<FormSetConfig[]> {
    Logger.info(`ExcelJSConfigLoader: reading ${filePath}`);

    const workbook = new Workbook();

    try {
      await workbook.xlsx.readFile(filePath);
    } catch (err) {
      throw new Error(
        `ExcelJSConfigLoader: cannot read "${filePath}".\n` +
        `Ensure the file exists at: src/coverage/data/forms-config.xlsx\n` +
        `Error: ${(err as Error).message}`
      );
    }

    const worksheet = workbook.worksheets[0];
    if (!worksheet) {
      throw new Error(`ExcelJSConfigLoader: no worksheets in "${filePath}".`);
    }

    Logger.info(
      `ExcelJSConfigLoader: sheet "${worksheet.name}" | ${worksheet.rowCount} rows`
    );

    const headerRow   = worksheet.getRow(1);
    const columnIndex = this.buildColumnIndex(headerRow, filePath);
    const rows: Record<string, string>[] = [];

    worksheet.eachRow((row: Row, rowNumber: number) => {
      if (rowNumber === 1) return;

      const record: Record<string, string> = {};
      let   hasData = false;

      for (const colName of Object.keys(columnIndex)) {
        const colIdx        = columnIndex[colName];
        const cell          = row.getCell(colIdx);
        const value         = this.readCellValue(cell);
        record[colName]     = value;
        if (value) hasData  = true;
      }

      if (hasData) rows.push(record);
    });

    Logger.info(`ExcelJSConfigLoader: parsed ${rows.length} data rows`);

    const result = this.buildFormSetConfigs(rows);

    Logger.info(
      `ExcelJSConfigLoader: ${result.length} form sets | ` +
      `${result.reduce((n, fs) => n + fs.forms.length, 0)} forms`
    );

    return result;
  }

  // ── Column Index ─────────────────────────────────────────────────────────────

  private static buildColumnIndex(
    headerRow: Row,
    filePath:  string,
  ): Record<string, number> {

    const index: Record<string, number> = {};

    headerRow.eachCell((cell: Cell, colNumber: number) => {
      const header = this.readCellValue(cell).trim();
      if (header) index[header] = colNumber;
    });

    const missing: string[] = REQUIRED_COLUMNS.filter(
      (col) => index[col] === undefined
    );

    if (missing.length > 0) {
      throw new Error(
        `ExcelJSConfigLoader: missing columns in "${filePath}":\n` +
        `  Missing: ${missing.join(', ')}\n` +
        `  Found:   ${Object.keys(index).join(', ')}\n` +
        `Column names are case-sensitive.`
      );
    }

    return index;
  }

  // ── FormSet Hierarchy Builder ─────────────────────────────────────────────────

  private static buildFormSetConfigs(rows: Record<string, string>[]): FormSetConfig[] {

    /**
     * Key: Product || SubSegment || Formset
     * The Formset column value is used directly (e.g. "Builder's Risk, Construction Block")
     * The formSetName for the radio button is derived by taking the first segment before comma.
     */
    const formSetMap = new Map<string, {
      product:     string;
      subSegment:  string;
      formset:     string;
      formSetName: string;
      forms: Map<string, {
        formId:     string;
        formNumber: string;
        formName:   string;
        formOrder:  number;
        category:   'Mandatory' | 'Optional';
        fields:     FormFieldConfig[];
      }>;
    }>();

    for (const row of rows) {

      const product    = row[COL.PRODUCT]?.trim();
      const subSegment = row[COL.SUB_SEGMENT]?.trim() ?? '';
      const formset    = row[COL.FORMSET]?.trim() ?? '';
      const formName   = row[COL.FORM_NAME]?.trim();

      if (!product || !formName) continue;

      const formSetKey = `${product}||${subSegment}||${formset}`;
      const formId     = row[COL.FORM_ID]?.trim() ?? '';
      const formNumber = row[COL.FORM_NUMBER]?.trim() ?? '';
      const formKey    = `${formId}||${formName}`;

      // Derive the radio button label from formset:
      // "Builder's Risk, Construction Block" → "Builder's Risk"
      const formSetName = formset.split(',')[0].trim();

      if (!formSetMap.has(formSetKey)) {
        formSetMap.set(formSetKey, {
          product,
          subSegment,
          formset,
          formSetName,
          forms: new Map(),
        });
      }

      const fsEntry = formSetMap.get(formSetKey)!;

      if (!fsEntry.forms.has(formKey)) {
        const orderRaw = row[COL.FORM_ORDER]?.trim();
        fsEntry.forms.set(formKey, {
          formId,
          formNumber,
          formName,
          formOrder:  orderRaw ? parseInt(orderRaw, 10) || 0 : 0,
          category:   this.parseCategory(row[COL.CATEGORY], formName),
          fields:     [],
        });
      }

      const formEntry  = fsEntry.forms.get(formKey)!;
      const fieldLabel = row[COL.FIELD]?.trim();

      if (fieldLabel) {
        formEntry.fields.push(this.buildField(row, formId, fieldLabel));
      }
    }

    return Array.from(formSetMap.values()).map(
      ({ product, subSegment, formset, formSetName, forms }) => ({
        product,
        subSegment,
        formset,
        formSetName,
        // Sort forms by formOrder
        forms: Array.from(forms.values()).sort((a, b) => a.formOrder - b.formOrder),
      })
    );
  }

  // ── Field Builder ─────────────────────────────────────────────────────────────

  private static buildField(
    row:        Record<string, string>,
    formId:     string,
    fieldLabel: string,
  ): FormFieldConfig {

    const mapping    = row[COL.MAPPING]?.trim() ?? '';
    const hasMapping = mapping !== '' && mapping.toLowerCase() !== 'n/a';
    const typeRaw    = row[COL.TYPE]?.trim() ?? 'Text';
    const parsedType = this.parseType(typeRaw);

    const config: FormFieldConfig = {
      fieldLabel,
      fieldSelector:    this.resolveSelector(row, formId, fieldLabel),
      type:             parsedType,
      required:         row[COL.REQUIRED]?.trim().toLowerCase() === 'yes',
      mapping,
      statesApplicable: row[COL.STATES_APPLICABLE]?.trim() || 'All',
      editable:         !hasMapping,
    };

    // Parse grid config if type is grid
    if (parsedType === 'grid') {
      config.gridConfig = this.parseGridConfig(typeRaw);
    }

    return config;
  }

  // ── Selector Resolution ───────────────────────────────────────────────────────

  private static resolveSelector(
    row:        Record<string, string>,
    formId:     string,
    fieldLabel: string,
  ): string {
    const fieldSelectorKey = COL.FIELD_SELECTOR;
    const explicit         = row[fieldSelectorKey]?.trim();
    if (explicit) return `#${explicit}`;

    const slug = fieldLabel
      .toLowerCase()
      .replace(/[^a-z0-9\s]/g, '')
      .trim()
      .replace(/\s+/g, '-');

    const derived = `#${formId.toLowerCase().replace(/\s+/g, '-')}-${slug}`;

    Logger.warn(
      `ExcelJSConfigLoader: "Field Selector" missing for "${fieldLabel}". ` +
      `Using derived: ${derived}.`
    );

    return derived;
  }

  // ── Parsers ───────────────────────────────────────────────────────────────────

  private static parseCategory(
    raw:      string | undefined,
    formName: string,
  ): 'Mandatory' | 'Optional' {
    const value = raw?.trim();
    if (value === 'Mandatory') return 'Mandatory';
    if (value === 'Optional')  return 'Optional';
    Logger.warn(`Unknown category "${value}" for "${formName}" — defaulting to Optional`);
    return 'Optional';
  }

  /**
   * Parses field type from the Excel Type column.
   *
   * Simple cases: 'Text' → 'text', 'Date' → 'date'
   *
   * Grid case (from screenshot):
   *   "Grid [Columns: Loc. No(s), Bldg.No(s), %Deductible] [Rows 3]" → 'grid'
   *   "Grid [Rows: Test]" → 'grid'
   */
  private static parseType(raw: string): FieldType {
    const normalised = raw.trim().toLowerCase();

    if (normalised.startsWith('grid')) return 'grid';

    const typeMap: Record<string, FieldType> = {
      'text':     'text',
      'number':   'number',
      'dropdown': 'dropdown',
      'select':   'dropdown',
      'checkbox': 'checkbox',
      'radio':    'radio',
      'date':     'date',
      'textarea': 'textarea',
    };

    const mapped = typeMap[normalised];
    if (!mapped) Logger.warn(`Unknown type "${raw}" — defaulting to text`);
    return mapped ?? 'text';
  }

  /**
   * Parses Grid configuration from the Type column value.
   *
   * Input:  "Grid [Columns: Loc. No(s), Bldg.No(s), %Deductible] [Rows 3]"
   * Output: { columns: ['Loc. No(s)', 'Bldg.No(s)', '%Deductible'], rowCount: 3 }
   *
   * Input:  "Grid [Rows: Test]"
   * Output: { columns: [], rowCount: 0 }
   */
  private static parseGridConfig(raw: string): GridConfig {
    const columns:  string[] = [];
    let   rowCount: number   = 0;

    // Extract columns: [Columns: col1, col2, col3]
    const colMatch = raw.match(/\[Columns:\s*([^\]]+)\]/i);
    if (colMatch) {
      colMatch[1].split(',').forEach((c) => {
        const trimmed = c.trim();
        if (trimmed) columns.push(trimmed);
      });
    }

    // Extract row count: [Rows 3] or [Rows: Test]
    const rowMatch = raw.match(/\[Rows\s*:?\s*(\d+)\]/i);
    if (rowMatch) {
      rowCount = parseInt(rowMatch[1], 10) || 0;
    }

    return { columns, rowCount };
  }

  // ── Cell Reader ───────────────────────────────────────────────────────────────

  private static readCellValue(cell: Cell): string {
    const value = cell.value;
    if (value === null || value === undefined) return '';

    if (typeof value === 'object' && 'richText' in value) {
      return (value as CellRichTextValue).richText.map((r) => r.text ?? '').join('');
    }
    if (typeof value === 'object' && 'result' in value) {
      const r = (value as CellFormulaValue).result;
      return r !== null && r !== undefined ? String(r) : '';
    }
    if (typeof value === 'object' && 'text' in value && 'hyperlink' in value) {
      return String((value as CellHyperlinkValue).text ?? '');
    }
    if (value instanceof Date) return value.toLocaleDateString('en-US');
    return String(value);
  }
}
