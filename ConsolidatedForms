 *
 * UPDATED:
 *   - StoredSubmission now includes displayId and submissionUrl
 *   - quoteId is the user-entered Quote ID (e.g. 'QO-2')
 *   - updateQuoteId(metrixSubmissionId, quoteId) updates stored quote
 */
export class SubmissionManager {

  static store(submission: StoredSubmission): void {
    const data = this.readAll();
    data[submission.metrixSubmissionId] = submission;
    this.write(data);
    Logger.info(`Submission stored: ${submission.metrixSubmissionId}`);
  }

  static updateQuoteId(metrixSubmissionId: string, quoteId: string): void {
    const data     = this.readAll();
    const existing = data[metrixSubmissionId];

    if (!existing) {
      Logger.warn(`SubmissionManager.updateQuoteId: no submission for ${metrixSubmissionId}`);
      return;
    }

    existing.quoteId = quoteId;
    data[metrixSubmissionId] = existing;
    this.write(data);
    Logger.info(`QuoteId updated for ${metrixSubmissionId}: ${quoteId}`);
  }

  static get(metrixSubmissionId: string): StoredSubmission | null {
    return this.readAll()[metrixSubmissionId] ?? null;
  }

  static getAll(): StoredSubmission[] {
    return Object.values(this.readAll());
  }

  static getLatest(): StoredSubmission | null {
    const all = this.getAll();
    if (!all.length) return null;
    return all.sort((a, b) => b.createdAt - a.createdAt)[0];
  }

  static getLatestWithQuote(): StoredSubmission | null {
    const all = this.getAll().filter(
      (s) => s.quoteId && s.quoteId.trim() !== ''
    );
    if (!all.length) return null;
    return all.sort((a, b) => b.createdAt - a.createdAt)[0];
  }

  static remove(metrixSubmissionId: string): void {
    const data = this.readAll();
    delete data[metrixSubmissionId];
    this.write(data);
  }

  static clearAll(): void {
    this.write({});
    Logger.info('All submissions cleared');
  }

  private static readAll(): Record<string, StoredSubmission> {
    if (!fs.existsSync(STORE_FILE)) return {};
    try { return JSON.parse(fs.readFileSync(STORE_FILE, 'utf-8')); }
    catch { return {}; }
  }

  private static write(data: Record<string, StoredSubmission>): void {
    fs.mkdirSync(path.dirname(STORE_FILE), { recursive: true });
    fs.writeFileSync(STORE_FILE, JSON.stringify(data, null, 2), 'utf-8');
  }
}
