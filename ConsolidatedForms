typescript
import { test, expect }           from '../../src/fixtures/index';
import { FormRegistry }           from '../../src/coverage/registry/FormRegistry';
import { FormSetConfig, SubmissionDataMap } from '../../src/coverage/types/coverage.types';
import { SubmissionManager }      from '../../src/data/managers/SubmissionManager';
import { Tags }                   from '../../src/constants/test-tags.constants';
import { Role }                   from '../../src/enums/role.enum';
import { SubmissionOverviewPage } from '../../src/pages/SubmissionOverviewPage';
import { CoverageExposuresPage }  from '../../src/pages/CoverageExposuresPage';
import { QuotePage }              from '../../src/pages/QuotePage';
import { FormsPage }              from '../../src/pages/FormsPage';

test.use({ role: Role.UW });

test.describe('Forms — Field Verification (Data-Driven from Excel)', () => {

  let allFormSets: FormSetConfig[] = [];

  test.beforeAll(async () => {
    allFormSets = await FormRegistry.getAll();
  });

  test(`${Tags.SMOKE} ${Tags.FORM_FIELDS} Excel config loads with correct columns`, async () => {
    expect(allFormSets.length, 'At least one Form Set must load').toBeGreaterThan(0);
    const totalForms = allFormSets.reduce((n, fs) => n + fs.forms.length, 0);
    expect(totalForms, 'At least one form must be configured').toBeGreaterThan(0);
    console.log(
      `Loaded: ${allFormSets.length} form sets | ${totalForms} forms | ` +
      `columns: Product, Sub Segment, Formset, Form Number, Form Name, Form ID, ` +
      `Form Order, Category, States Applicable, Field, Type, Required, Mapping`
    );
  });

  test(
    `${Tags.COVERAGE} ${Tags.FORM_FIELDS} Verify form fields across all Form Sets`,
    async ({ submissionOverview }) => {

      const stored = SubmissionManager.getLatestWithQuote();

      if (!stored) {
        test.skip(
          true,
          'No stored submission with quoteId.\n' +
          'Run: npx playwright test tests/coverage/coverage-e2e.spec.ts first.'
        );
        return;
      }

      // Navigate using stored URL (most reliable)
      await submissionOverview.navigateByUrl(stored.submissionUrl);
      await submissionOverview.verifyPageLoaded();

      // Sidebar → Exposures & Quotes → Open quote → Forms tab
      await submissionOverview.clickExposuresAndQuotes();

      const coveragePage = new CoverageExposuresPage(submissionOverview['page']);
      await coveragePage.verifyPageLoaded();
      await coveragePage.openQuoteByLink(stored.quoteId);

      const quotePage = new QuotePage(submissionOverview['page']);
      await quotePage.verifyPageLoaded();
      await quotePage.clickFormsTab();

      const formsPage = new FormsPage(submissionOverview['page']);
      await formsPage.verifyPageLoaded();

      /**
       * submissionData map — Mapping key → actual value.
       *
       * Keys come from the "Mapping" column in the Excel file.
       * Values come from what was entered in the application.
       *
       * EXAMPLES based on Image 4 fields (INSURED, POLICY NUMBER, EFFECTIVE DATE etc.):
       */
      const submissionData: SubmissionDataMap = {
        // From submission creation:
        'Named Insured':     stored.namedInsured,
        'Submission Number': stored.submissionNumber,
        'Insured':           stored.namedInsured,

        // TODO: Add remaining Mapping values from your Excel file.
        // Run tests once → check logs for warnings → add missing keys:
        //
        // 'Policy Number':          'POL-001234',
        // 'Effective Date':         '09/08/2026',
        // 'Expiration Date':        '09/08/2027',
        // 'Premium':                '5000',
        // 'Limits of Insurance':    '1000000',
        // 'Deductible Amount':      '5000',
        // 'Coinsurance':            '80',
        // 'Under Hurricane Deductible': '10000',    ← from Mapping column in Excel
        // 'Minimum Deductible':     '2500',
      };

      // Values for editable fields (no Mapping in Excel)
      const editableValues: SubmissionDataMap = {
        // TODO: Add values for editable fields (those with no Mapping)
        // Key = "Field" label from Excel
        //
        // 'Premium for This Coverage Form ($)': '5000',
        // 'Construction Project Site(s) - Address': '123 Main St',
        // 'Description of Covered Property': 'Residential construction project',
      };

      // Process all Form Sets
      for (const formSet of allFormSets) {
        await formsPage.selectFormSet(formSet.formSetName);
        await formsPage.assertFormSetSelected(formSet.formSetName);

        for (const form of formSet.forms) {

          // Mandatory: verify pre-checked + disabled
          if (form.category === 'Mandatory') {
            await formsPage.assertMandatoryForm(form.formName);
          } else {
            await formsPage.selectOptionalForm(form.formName);
            await formsPage.assertOptionalFormIsChecked(form.formName);
          }

          // Skip if no fields in Excel
          if (form.fields.length === 0) {
            console.log(`Skipping "${form.formName}" — no fields in Excel`);
            continue;
          }

          // Click form → view its fields in right panel
          await formsPage.clickFormToViewFields(form.formName);

          // Process fields (verify pre-populated, fill editable)
          const result = await formsPage.processForm(form, submissionData, editableValues);

          // Assert all verifications passed
          const failures = result.fields
            .filter((f) => !f.passed)
            .map((f) =>
              `  ┌ Field:    "${f.fieldLabel}"\n` +
              `  │ Mapping:  "${f.mapping}"\n` +
              `  │ Expected: "${f.expected}"\n` +
              `  └ Actual:   "${f.actual}"`
            );

          expect(
            failures,
            `${failures.length} field(s) failed in "${form.formName}" [${formSet.formSetName}]:\n\n` +
            failures.join('\n\n')
          ).toHaveLength(0);
        }
      }
    }
  );
});
