  }

  // ── Form Fields Panel (right panel — appears when form is clicked) ─────────

  /**
   * Clicks a form in the left Forms list to show its fields on the right panel.
   * From Images 3, 4: clicking a form shows Form Fields panel on the right.
   * Image 2 shows "Fetching the document for the form" loading spinner.
   */
  async clickFormToViewFields(formName: string): Promise<void> {
    this.log(`Clicking form "${formName}" to view fields...`);

    const formLink = this.formListPanel
      .locator(`text="${formName}"`)
      .or(this.page.locator(`[data-form-name="${formName}"]`))
      .first();

    await expect(formLink, `Form "${formName}" should be in the forms list`).toBeVisible();
    await formLink.click();

    // Wait for "Fetching the document for the form" spinner to appear then disappear
    try {
      await this.fetchingFormSpinner.waitFor({ state: 'visible', timeout: 3_000 });
      await this.fetchingFormSpinner.waitFor({ state: 'hidden',  timeout: 30_000 });
    } catch {
      this.log('Fetch spinner not detected for this form');
    }

    await this.page.waitForLoadState('networkidle');

    // Form Fields panel should now be visible on the right
    await expect(
      this.formFieldsPanel,
      `Form Fields panel should appear after clicking "${formName}"`
    ).toBeVisible();

    this.log(`Form "${formName}" fields loaded`);
  }

  /**
   * Asserts a specific form field is visible in the Form Fields panel.
   * From Image 4: fields like INSURED, POLICY NUMBER, EFFECTIVE DATE etc.
   */
  async assertFormFieldVisible(fieldLabel: string): Promise<void> {
    await expect(
      this.formFieldsPanel.locator(`text="${fieldLabel}"`),
      `Form field "${fieldLabel}" should be visible`
    ).toBeVisible();
    this.log(`✅ Field visible: ${fieldLabel}`);
