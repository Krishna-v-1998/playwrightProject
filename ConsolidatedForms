export type FieldType =
  | 'text'
  | 'number'
  | 'dropdown'
  | 'checkbox'
  | 'radio'
  | 'date'
  | 'textarea'
  | 'grid';     // ← NEW: table-like field with columns and rows (seen in Excel)

// ── Grid Config ───────────────────────────────────────────────────────────────

/**
 * Configuration for Grid field type.
 * Parsed from Excel "Type" column values like:
 *   "Grid [Columns: Loc. No(s), Bldg.No(s), %Deductible] [Rows 3]"
 */
export interface GridConfig {
  columns:  string[];  // column names
  rowCount: number;    // number of rows
}

// ── Field Config ──────────────────────────────────────────────────────────────

/**
 * Represents one row in the Excel file (one field in one form).
 *
 * Excel columns (from actual screenshot):
 *   Product | Sub Segment | Formset | Form Number | Form Name | Form ID |
 *   Form Order | Category | States Applicable | Field | Type | Required | Mapping
 */
export interface FormFieldConfig {
  fieldLabel:       string;      // "Field" column
  fieldSelector:    string;      // derived or from optional "Field Selector" column
  type:             FieldType;   // "Type" column (parsed)
  gridConfig?:      GridConfig;  // only for type='grid' — parsed from Type column
  required:         boolean;     // "Required" column (Yes/No)
  mapping:          string;      // "Mapping" column — key/description for value lookup
  statesApplicable: string;      // "States Applicable" column
  editable:         boolean;     // false = pre-populated (verify) | true = user-fills
}

