   * Pre-populated fields are disabled per the requirements.
   */
  async assertFieldIsDisabled(selector: string, fieldLabel: string): Promise<void> {
    const locator  = this.page.locator(selector);
    const disabled = await locator.isDisabled();
    const readOnly = await locator.getAttribute('readonly') !== null;
    expect(
      disabled || readOnly,
      `Field "${fieldLabel}" (${selector}) should be disabled/read-only`
    ).toBeTruthy();
    this.log(`✅ Field disabled: ${fieldLabel}`);
  }

  async assertFieldIsEnabled(selector: string, fieldLabel: string): Promise<void> {
    await expect(
      this.page.locator(selector),
      `Field "${fieldLabel}" should be enabled`
    ).toBeEnabled();
    this.log(`✅ Field enabled: ${fieldLabel}`);
  }

  async assertFieldValue(selector: string, expected: string, fieldLabel: string): Promise<void> {
    await expect(
      this.page.locator(selector),
      `Field "${fieldLabel}" should have value "${expected}"`
    ).toHaveValue(expected);
  }

  // ── Save ───────────────────────────────────────────────────────────────────

  async save(): Promise<void> {
    await this.saveButton.click();
    await this.page.waitForLoadState('networkidle');
    this.log('Saved forms');
  }

  /**
   * Clicks "Forms Preview >" button.
   * Opens a PDF in a new tab (from Image 2, 3 context + user confirmation).
   *
   * Returns the new PDF tab for FormsPreviewPage.
   * OUT OF SCOPE for current sprint — scaffold only.
   */
  async clickFormsPreviewButton(): Promise<Page> {
    await expect(this.formsPreviewButton, '"Forms Preview >" should be visible').toBeVisible();

    this.log('Clicking "Forms Preview >" — PDF will open in new tab');

    const [pdfTab] = await Promise.all([
      this.page.context().waitForEvent('page', { timeout: 30_000 }),
      this.formsPreviewButton.click(),
    ]);

    await pdfTab.waitForLoadState('networkidle');
    this.log(`Forms Preview PDF opened: ${pdfTab.url()}`);
    return pdfTab;
  }

  async assertFormsPreviewButtonVisible(): Promise<void> {
    await expect(this.formsPreviewButton, '"Forms Preview >" should be visible').toBeVisible();
    this.log('✅ Forms Preview button visible');
  }

  // ── FormEngine Delegation ─────────────────────────────────────────────────

  /**
   * Processes all fields in a form:
   *   - Verifies pre-populated fields against submissionData
   *   - Fills editable fields from editableValues
   *
   * Must call clickFormToViewFields(formName) first to load the form fields.
   */
  async processForm(
    form:            FormConfig,
    submissionData:  SubmissionDataMap,
    editableValues?: SubmissionDataMap,
  ): Promise<FormVerificationResult> {
    return FormEngine.processForm(this.page, form, submissionData, editableValues);
  }

