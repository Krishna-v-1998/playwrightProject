/**
 * UrlHelper
 *
 * Handles URL parsing for the hash-based routing application.
 *
 * ACTUAL URL formats observed in screenshots:
 *   Login:      /#/auth/login
 *   Dashboard:  /#/display/{pathId}                          (no metrixSubmissionId param)
 *   Submission: /#/display/{pathId}?metrixSubmissionId={id}  (has metrixSubmissionId param)
 *
 * TWO IDs exist in submission URLs:
 *   pathId           = segment after /display/ in hash path  (e.g. 6a3c26cf2ea7f188470de740)
 *   metrixSubmissionId = query param value                   (e.g. 6a9e938009d461e0953...)
 *
 * The metrixSubmissionId is the primary business key.
 * The pathId is required for URL reconstruction/navigation.
 */
export class UrlHelper {

  /**
   * Extracts the metrixSubmissionId query parameter from the URL hash.
   *
   * Input:  '.../#/display/6a3c26cf2ea7f188470de740?metrixSubmissionId=6a9e938009d461e0953'
   * Output: '6a9e938009d461e0953'
   */
  static extractMetrixSubmissionId(url: string): string {
    const hashPart  = url.split('#')[1] ?? '';
    const queryPart = hashPart.split('?')[1] ?? '';
    const params    = new URLSearchParams(queryPart);
    return params.get('metrixSubmissionId')?.trim() ?? '';
  }

  /**
   * Extracts the path-level display ID (segment after /display/ in the hash).
   *
   * Input:  '.../#/display/6a3c26cf2ea7f188470de740?metrixSubmissionId=...'
   * Output: '6a3c26cf2ea7f188470de740'
   *
   * Required for reconstructing the full submission URL for navigation.
   */
  static extractDisplayId(url: string): string {
    const hashPart = url.split('#')[1] ?? '';
    const pathPart = hashPart.split('?')[0] ?? '';
    const segments = pathPart.split('/').filter((s) => s.trim().length > 0);
    // segments = ['display', '6a3c26cf2ea7f188470de740'] → last segment is the ID
    return segments[segments.length - 1] ?? '';
  }

  /**
   * Builds a full submission URL from its two components.
   * Required because navigation needs both the path ID and metrixSubmissionId.
   *
   * Usage:
   *   const url = UrlHelper.buildSubmissionUrl(baseUrl, stored.displayId, stored.metrixSubmissionId);
   */
  static buildSubmissionUrl(
    baseUrl:             string,
    displayId:           string,
    metrixSubmissionId:  string,
  ): string {
    return `${baseUrl}/#/display/${displayId}?metrixSubmissionId=${metrixSubmissionId}`;
  }

  /**
   * Returns true if the URL is the login page.
   */
  static isLoginPage(url: string): boolean {
    return url.includes('#/auth/login');
  }

  /**
   * Returns true if the URL is the dashboard.
   * Dashboard: has /#/display/ in hash but NO metrixSubmissionId query param.
   */
  static isDashboard(url: string): boolean {
    const hashPart  = url.split('#')[1] ?? '';
    const queryPart = hashPart.split('?')[1] ?? '';
    const params    = new URLSearchParams(queryPart);
    return hashPart.includes('/display/') && !params.has('metrixSubmissionId');
  }

  /**
   * Returns true if the URL is an opened submission page.
   * Identified by presence of metrixSubmissionId query param in hash.
   */
  static isSubmissionPage(url: string): boolean {
    const hashPart  = url.split('#')[1] ?? '';
    const queryPart = hashPart.split('?')[1] ?? '';
    const params    = new URLSearchParams(queryPart);
    return params.has('metrixSubmissionId');
  }
}
