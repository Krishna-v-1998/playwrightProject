  private readonly formSetOrderTab:       Locator;  // "04 Form Set Order"

  // ── Quote Details (Step 01) ────────────────────────────────────────────────
  /**
   * Product tabs container — shows auto-generated tabs like "BR-2", "CE-1".
   * Tab label = sub-segment abbreviation + quote sequence number.
   *
   * ABBREVIATION MAP (from user clarification):
