    await this.formsNavigationButton.click();
    await this.page.waitForLoadState('networkidle');
    this.log('Clicked "Forms >" — navigated to Forms step');
  }

  /**
   * Clicks "Forms Preview >" button.
   * Opens a PDF in a NEW TAB (user-confirmed).
   * Out of scope for current sprint.
   *
   * Returns the new PDF tab Page reference.
   */
  async clickFormsPreviewButton(): Promise<Page> {
    await expect(this.formsPreviewButton, '"Forms Preview >" should be visible').toBeVisible();
    this.log('"Forms Preview >" clicked — PDF opening in new tab');

    const [pdfTab] = await Promise.all([
      this.page.context().waitForEvent('page', { timeout: 30_000 }),
      this.formsPreviewButton.click(),
    ]);

    await pdfTab.waitForLoadState('networkidle');
    this.log(`Forms Preview PDF tab: ${pdfTab.url()}`);
    return pdfTab;
