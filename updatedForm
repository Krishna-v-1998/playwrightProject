## Correction 1 — `src/pages/CoverageExposuresPage.ts`

Remove `quoteId` from `NewQuoteData`. The Quote ID field in the panel is auto-filled by the system. User only fills `effectiveDate`, `product`, `subSegment`, and optionally `description`.

```typescript
import { Page, Locator, expect } from '@playwright/test';
import { BasePage }               from './base/BasePage';
import { DropdownComponent }      from '../components/DropdownComponent';

/**
 * NewQuoteData
 *
 * Data the USER provides when creating a new quote.
 *
 * CORRECTED:
 *   REMOVED: quoteId — this is AUTO-GENERATED by the system (e.g. 'QO-2')
 *            The QUOTE ID field in the New Quote panel is auto-filled.
 *            Do not fill it — read it afterwards from QuotePage.
 *
 *   KEPT:    effectiveDate, product, subSegment, description (user-entered)
 */
export interface NewQuoteData {
  effectiveDate: string;   // MM/DD/YYYY — user enters this
  product:       string;   // e.g. 'Construction' — dropdown
  subSegment:    string;   // e.g. 'Construction-Builder\'s Risk' — dropdown
  description?:  string;   // optional
}

/**
 * CoverageExposuresPage
 *
 * Handles the "Exposures & Quotes" section accessed via the left sidebar.
 *
 * ACTUAL FLOW from screenshots:
 *   Sidebar: Exposures & Quotes
 *     → Page shows: Quote | Binder | Premium Booking | Policy tabs
 *     → Active Quotes / Archived Quotes radio
 *     → Quote table with columns: QUOTE ID | CLONED FROM | PRODUCT ID(S) | DESCRIPTION | STATE
 *     → Buttons: Finalize Quote | Send To | + Add New | Generate Binder
 *
 *   Click "+ Add New":
 *     → "New Quote" panel slides in from right (Image 17)
 *     → Fields: QUOTE ID (auto-filled), EFFECTIVE DATE, PRODUCT, SUB-SEGMENT, DESCRIPTION
 *     → QUOTE ID is AUTO-GENERATED by system — do NOT fill it
 *     → Click "Create" → same tab navigates to Quote Options
 *
 * SETUP REQUIRED: Replace all YOUR_*_SELECTOR placeholders.
 */
export class CoverageExposuresPage extends BasePage {

  // ── Page State ─────────────────────────────────────────────────────────────
  private readonly pageLoadedIndicator:  Locator;
  private readonly loadingSpinner:       Locator;

  // ── Main Tabs ──────────────────────────────────────────────────────────────
  private readonly quoteTab:             Locator;
  private readonly binderTab:            Locator;
  private readonly premiumBookingTab:    Locator;
  private readonly policyTab:            Locator;

  // ── Active/Archived Radio ──────────────────────────────────────────────────
  private readonly activeQuotesRadio:    Locator;
  private readonly archivedQuotesRadio:  Locator;

  // ── Quote Table ────────────────────────────────────────────────────────────
  private readonly quotesTable:          Locator;
  private readonly noDataFoundText:      Locator;

  // ── Action Buttons ─────────────────────────────────────────────────────────
  private readonly addNewButton:         Locator;
  private readonly finalizeQuoteButton:  Locator;
  private readonly sendToButton:         Locator;
  private readonly keywordSearch:        Locator;
  private readonly filterButton:         Locator;
  private readonly clearAllButton:       Locator;

  // ── New Quote Panel (slides in from right — Image 17) ─────────────────────
  private readonly newQuotePanel:              Locator;

  /**
   * QUOTE ID field is visible in the panel but AUTO-GENERATED by system.
   * We store this locator only to READ the auto-generated value.
   * We NEVER fill this field.
   */
  private readonly newQuoteQuoteIdInput:        Locator;   // read-only — auto-generated
  private readonly newQuoteEffectiveDateInput:  Locator;   // user fills
  private readonly newQuoteProductDropdown:     DropdownComponent; // user selects
  private readonly newQuoteSubSegmentDropdown:  DropdownComponent; // user selects
  private readonly newQuoteDescriptionInput:    Locator;   // user fills (optional)
  private readonly newQuoteCancelButton:        Locator;
  private readonly newQuoteCreateButton:        Locator;

  constructor(page: Page) {
    super(page);

    this.pageLoadedIndicator  = page.locator('YOUR_EXPOSURES_PAGE_LOADED_INDICATOR');
    this.loadingSpinner       = page.locator('YOUR_SPINNER_SELECTOR');

