  private readonly productTabsContainer:  Locator;
  private readonly addProductButton:      Locator;   // "+ Add Product"

  /**
   * PRODUCT ID field — READ-ONLY, auto-generated.
   * Shows the same value as the active product tab label (e.g. 'BR-2').
   */
  private readonly productIdField:        Locator;   // read-only display

  private readonly productDropdown:       DropdownComponent;  // pre-filled
  private readonly subSegmentDropdown:    DropdownComponent;  // pre-filled

  // ── Bottom Buttons ─────────────────────────────────────────────────────────
  private readonly cancelButton:          Locator;
  private readonly saveButton:            Locator;
  private readonly formsNavigationButton: Locator;  // "Forms >" (step 01 → 02)
  private readonly formsPreviewButton:    Locator;  // "Forms Preview >" (opens PDF in new tab)

  constructor(page: Page) {
