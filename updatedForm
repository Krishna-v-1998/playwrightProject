    this.log(`✅ Product pre-filled: ${actual}`);
  }

  /**
   * Asserts the Sub-segment dropdown shows the expected value.
   * This is pre-filled from the New Quote panel — not re-entered.
   */
  async assertSubSegmentPreFilled(expected: string): Promise<void> {
