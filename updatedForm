    await this.page.waitForLoadState('networkidle');
    this.log('Clicked 01 Quote Details tab');
  }

  async clickFormsTab(): Promise<void> {
    await this.formsTab.click();
    await this.page.waitForLoadState('networkidle');
    this.log('Clicked 02 Forms tab');
  }

  /**
   * Clicks "Forms >" button at bottom right.
   * Navigates from Quote Details (step 01) to Forms (step 02).
   */
  async clickFormsNavigationButton(): Promise<void> {
