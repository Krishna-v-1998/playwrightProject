   * This method reads what the system assigned (e.g. 'QO-2').
   * Call this BEFORE clicking Create, while the panel is still open.
   */
  async readAutoGeneratedQuoteId(): Promise<string> {
    // Wait briefly for the system to populate the field
    await this.page.waitForTimeout(500);
    const quoteId = (await this.newQuoteQuoteIdInput.inputValue()).trim();
    this.log(`Auto-generated Quote ID: ${quoteId}`);
    return quoteId;
  }

  /**
   * Fills the user-provided fields in the New Quote panel.
   *
   * CORRECTED: Does NOT fill quoteId — it is auto-generated.
   * Fills: effectiveDate, product, subSegment, description (if provided).
   */
  async fillNewQuotePanel(data: NewQuoteData): Promise<void> {
    // Effective Date — user fills this
    await this.newQuoteEffectiveDateInput.fill(data.effectiveDate);
    await this.newQuoteEffectiveDateInput.press('Tab');
    await this.page.waitForTimeout(300);

    // Product dropdown
    await this.newQuoteProductDropdown.select(data.product);
    await this.page.waitForTimeout(500); // wait for Sub-segment to load

    // Sub-segment dropdown — loads after Product selection
    await this.newQuoteSubSegmentDropdown.select(data.subSegment);

    // Description (optional)
    if (data.description) {
      await this.newQuoteDescriptionInput.fill(data.description);
    }

    this.log(
      `Filled New Quote panel: Product="${data.product}" SubSeg="${data.subSegment}"`
    );
  }

  /**
   * Clicks "Create" to submit the New Quote panel.
   * Navigates to Quote Options in the SAME TAB.
   */
  async clickCreate(): Promise<void> {
    await expect(this.newQuoteCreateButton, 'Create button should be visible').toBeVisible();
    await this.newQuoteCreateButton.click();
    await this.page.waitForLoadState('networkidle');
    this.log('Clicked Create — Quote Options loading in same tab');
  }

  /**
   * Complete workflow for creating a new quote:
   * 1. Click "+ Add New"
   * 2. Read the auto-generated Quote ID
   * 3. Fill user fields (effectiveDate, product, subSegment)
   * 4. Click Create
   *
   * Returns the auto-generated Quote ID (e.g. 'QO-2').
   * Use this to store in SubmissionManager for subsequent navigation.
   *
   * After calling this, create QuotePage with the same page reference:
   *   const autoQuoteId = await coveragePage.createNewQuote(data);
   *   const quotePage   = new QuotePage(page);
   *   await quotePage.verifyPageLoaded();
   */
  async createNewQuote(data: NewQuoteData): Promise<string> {
    await this.clickAddNew();

    // Read auto-generated Quote ID BEFORE filling other fields
    const autoGeneratedQuoteId = await this.readAutoGeneratedQuoteId();

    await this.fillNewQuotePanel(data);
    await this.clickCreate();

    this.log(`Quote created with auto-generated ID: ${autoGeneratedQuoteId}`);
    return autoGeneratedQuoteId;
  }

  /**
   * Opens an existing quote by clicking its Quote ID hyperlink in the table.
   * For subsequent test runs (not the first creation).
   * Always use the latest quote — pass stored.quoteId.
   */
  async openQuoteByLink(quoteId: string): Promise<void> {
    this.log(`Opening quote: ${quoteId}`);

    const quoteLink = this.quotesTable
      .locator(`a:has-text("${quoteId}")`)
      .or(this.quotesTable.locator(`td:has-text("${quoteId}") a`))
      .or(this.quotesTable.locator(`[data-quote-id="${quoteId}"]`))
      .first();

    await expect(
      quoteLink,
      `Quote link "${quoteId}" should be visible in quotes table`
    ).toBeVisible();

    await quoteLink.click();
    await this.page.waitForLoadState('networkidle');
    this.log(`Opened quote: ${quoteId}`);
  }

  async assertAddNewButtonVisible(): Promise<void> {
    await expect(this.addNewButton, '"+ Add New" should be visible').toBeVisible();
  }

  async cancelNewQuotePanel(): Promise<void> {
    await this.newQuoteCancelButton.click();
    await this.newQuotePanel.waitFor({ state: 'hidden', timeout: 5_000 });
    this.log('Cancelled New Quote panel');
  }
}
