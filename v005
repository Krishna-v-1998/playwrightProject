import { test, expect }      from '../../src/fixtures/index';
import { Tags }              from '../../src/constants/test-tags.constants';
import { Role }              from '../../src/enums/role.enum';
import { SubmissionFactory } from '../../src/data/factories/SubmissionFactory';
import { SubmissionManager } from '../../src/data/managers/SubmissionManager';

test.use({ role: Role.UW });

test.describe('Broker Information Tab — Validation', () => {

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 1 — Create submission → verify Broker tab
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Auto-population after submission creation', () => {

    test.beforeEach(async ({ dashboardPage }) => {
      await dashboardPage.navigate();
    });

    test(
      `${Tags.SMOKE} ${Tags.BROKER} `
      + 'All broker fields auto-populated from New Submission Modal data',

      async ({
        dashboardPage,
        newSubmissionModal,
        authenticatedPage,
        submissionOverview,
        brokerInfoPage,
      }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        await newSubmissionModal.verifyPageLoaded();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        await submissionOverview.navigateByUrl(newTab.url());
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.waitForDataLoaded(data.insured.namedInsured);
        await submissionOverview.clickBrokerInformationTab();

        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.assertAutoPopulatedFromSubmission(data);
      }
    );

    test(
      `${Tags.SANITY} ${Tags.BROKER} Broker Company matches modal entry`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage, submissionOverview, brokerInfoPage }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        await submissionOverview.navigateByUrl(newTab.url());
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.waitForDataLoaded(data.insured.namedInsured);
        await submissionOverview.clickBrokerInformationTab();

        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.assertBrokerCompany(data.broker.brokerCompany);
      }
    );

    test(
      `${Tags.SANITY} ${Tags.BROKER} Broker Country defaults to USA`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage, submissionOverview, brokerInfoPage }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        await submissionOverview.navigateByUrl(newTab.url());
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.waitForDataLoaded(data.insured.namedInsured);
        await submissionOverview.clickBrokerInformationTab();

        await brokerInfoPage.verifyPageLoaded();
        // DropdownComponent.getSelectedValue() used internally
        await brokerInfoPage.assertDefaultCountry();
      }
    );

    test(
      `${Tags.SANITY} ${Tags.BROKER} Broker address fields match modal entries`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage, submissionOverview, brokerInfoPage }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        await submissionOverview.navigateByUrl(newTab.url());
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.waitForDataLoaded(data.insured.namedInsured);
        await submissionOverview.clickBrokerInformationTab();

        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.assertStreetAddress(data.broker.streetAddress);
        await brokerInfoPage.assertCity(data.broker.city);
        await brokerInfoPage.assertState(data.broker.state);
        await brokerInfoPage.assertZip(data.broker.zip);
      }
    );
  });

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 2 — Stored submission → email, commission, counter tests
  // Use beforeEach to navigate once — all tests in this block share it
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Email, Commission and Counter tests on stored submission', () => {

    test.beforeEach(async ({ submissionOverview }) => {
      const stored = SubmissionManager.getLatest();
      if (!stored) return;

      await submissionOverview.navigateByUrl(stored.submissionUrl);
      await submissionOverview.verifyPageLoaded();
      await submissionOverview.waitForDataLoaded(stored.namedInsured);
      await submissionOverview.clickBrokerInformationTab();
    });

    // ── Email ───────────────────────────────────────────────────────────────

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Valid email — no error shown`,

      async ({ brokerInfoPage }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.fillEmail('valid@company.com');
        await brokerInfoPage.assertNoEmailValidationError();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Email without @ — shows error`,

      async ({ brokerInfoPage }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.fillEmail('invalidemail.com');
        await brokerInfoPage.assertEmailValidationError();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Plain text email — shows error`,

      async ({ brokerInfoPage }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.fillEmail('notanemail');
        await brokerInfoPage.assertEmailValidationError();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Fixing invalid email clears the error`,

      async ({ brokerInfoPage }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.fillEmail('bademail');
        await brokerInfoPage.assertEmailValidationError();
        await brokerInfoPage.fillEmail('fixed@company.com');
        await brokerInfoPage.assertNoEmailValidationError();
      }
    );

    // ── Commission ──────────────────────────────────────────────────────────

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Commission = 100 is valid`,

      async ({ brokerInfoPage }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.fillCommission(100);
        await brokerInfoPage.assertNoCommissionValidationError();
        await brokerInfoPage.assertCommission(100);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Commission = 0 is valid`,

      async ({ brokerInfoPage }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.fillCommission(0);
        await brokerInfoPage.assertNoCommissionValidationError();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Commission = 101 shows error`,

      async ({ brokerInfoPage }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.fillCommission(101);
        await brokerInfoPage.assertCommissionValidationError();
      }
    );

    // ── Character Counter ───────────────────────────────────────────────────

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Counter starts at 2000 when field is empty`,

      async ({ brokerInfoPage }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.clearBrokerNotes();
        await brokerInfoPage.assertCounterAtMaximum();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Typing 50 chars → counter shows 1950`,

      async ({ brokerInfoPage }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.clearBrokerNotes();
        await brokerInfoPage.fillBrokerNotes('A'.repeat(50));
        await brokerInfoPage.assertCounterAfterTyping(50);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Counter reaches 0 at 2000 chars`,

      async ({ brokerInfoPage }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.clearBrokerNotes();
        await brokerInfoPage.fillBrokerNotes('C'.repeat(2000));
        await brokerInfoPage.assertCounterAtZero();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Counter resets to 2000 after clearing`,

      async ({ brokerInfoPage }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.fillBrokerNotes('Some text here');
        await brokerInfoPage.clearBrokerNotes();
        await brokerInfoPage.assertCounterAtMaximum();
      }
    );
  });

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 3 — Guest Role
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Guest Role', () => {

    test.use({ role: Role.GUEST });

    test(
      `${Tags.REGRESSION} ${Tags.GUEST} Broker fields disabled for Guest`,

      async ({ submissionOverview, brokerInfoPage }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await submissionOverview.navigateByUrl(stored.submissionUrl);
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.waitForDataLoaded(stored.namedInsured);
        await submissionOverview.clickBrokerInformationTab();

        await brokerInfoPage.verifyPageLoaded();
        await expect(brokerInfoPage['brokerCompanyInput']).toBeDisabled();
        await expect(brokerInfoPage['emailInput']).toBeDisabled();
        await expect(brokerInfoPage['commissionInput']).toBeDisabled();
      }
    );
  });
});
  
