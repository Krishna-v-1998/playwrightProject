import { test, expect }      from '../../src/fixtures/index';
import { Tags }              from '../../src/constants/test-tags.constants';
import { Role }              from '../../src/enums/role.enum';
import { SubmissionFactory } from '../../src/data/factories/SubmissionFactory';
import { SubmissionManager } from '../../src/data/managers/SubmissionManager';
import { DateHelper }        from '../../src/helpers/DateHelper';

test.use({ role: Role.UW });

test.describe('Policy Information Tab — Validation', () => {

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 1 — Create submission → verify Policy tab
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Auto-population after submission creation', () => {

    test.beforeEach(async ({ dashboardPage }) => {
      await dashboardPage.navigate();
    });

    test(
      `${Tags.SMOKE} ${Tags.POLICY} `
      + 'All policy fields auto-populated from New Submission Modal data',

      async ({
        dashboardPage,
        newSubmissionModal,
        authenticatedPage,
        submissionOverview,
        policyInfoPage,
      }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        await newSubmissionModal.verifyPageLoaded();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        await submissionOverview.navigateByUrl(newTab.url());
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.waitForDataLoaded(data.insured.namedInsured);
        await submissionOverview.clickPolicyInformationTab();

        await policyInfoPage.verifyPageLoaded();
        await policyInfoPage.assertAutoPopulatedFromSubmission(data);
      }
    );

    test(
      `${Tags.SANITY} ${Tags.POLICY} Submission Number matches creation data`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage, submissionOverview, policyInfoPage }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        await submissionOverview.navigateByUrl(newTab.url());
        await submissionOverview.verifyPageLoaded();
