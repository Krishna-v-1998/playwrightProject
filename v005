import { test, expect }               from '../../src/fixtures/index';
import { Tags }                       from '../../src/constants/test-tags.constants';
import { Role }                       from '../../src/enums/role.enum';
import { SubmissionContext }          from '../../src/types/submission.types';
import { SubmissionSetupService }     from '../../src/services/SubmissionSetupService';
import { DateHelper }                 from '../../src/helpers/DateHelper';

/**
 * general-information.spec.ts
 *
 * Tests General Information — the EDITABLE section of a submission.
 * Three tabs: Insured Information | Policy Information | Broker Information
 *
 * ── SPEC DESIGN ──────────────────────────────────────────────────────────
 *   ONE submission created in the outer beforeAll.
 *   Shared across all three tab describe blocks.
 *   Each tab's beforeEach navigates fresh and clicks the correct tab.
 *
 *   TEST ORDER WITHIN EACH DESCRIBE:
 *     1. Auto-population validation (read-only checks against formData)
 *     2. Edit tests (modify fields and verify — may persist changes)
 *     3. Validation tests (error states, constraints)
 *
 *   IMPORTANT: Edit tests run after auto-population checks.
 *   If an edit test modifies a field, subsequent auto-population tests
 *   would see modified data. By ordering read-first, this is avoided.
 *
 * ── NAVIGATION PATTERN ───────────────────────────────────────────────────
 *   beforeEach for each tab describe:
 *     1. navigateByUrl() — fresh navigation to submission
 *     2. waitUntilLoaded() — wait for Overview data (confirms page is ready)
 *     3. clickXxxInformationTab() — navigate to the specific tab
 *     4. In test: page.verifyPageLoaded() — confirm tab is active
 *
 * ── WHY waitUntilLoaded() IN TAB BEFOREEACH ──────────────────────────────
 *   Even though we're going to a tab (not validating the Overview),
 *   waitUntilLoaded() is called because:
 *     - It confirms the submission page has loaded completely
 *     - The editable tab fields may also have async population
 *     - It ensures consistent, stable state before tab navigation
 */

test.use({ role: Role.UW });

test.describe('General Information', () => {

  // ── Single submission shared by ALL tests in this file ───────────────────
  let submissionCtx!: SubmissionContext;

  test.beforeAll(async ({ browser }) => {
    submissionCtx = await SubmissionSetupService.createAndStoreContext(browser, Role.UW);

    console.log([
      '',
      '=== Submission Created (General Information Suite) ===',
      `  Submission No:      ${submissionCtx.formData.submissionNumber}`,
      `  Named Insured:      ${submissionCtx.formData.insured.namedInsured}`,
      `  Policy Type:        ${submissionCtx.formData.policyType}`,
      `  metrixSubmissionId: ${submissionCtx.metrixSubmissionId}`,
      '=====================================================',
    ].join('\n'));
  });

  // ════════════════════════════════════════════════════════════════════════
  // TAB 1 — INSURED INFORMATION
  // ════════════════════════════════════════════════════════════════════════

  test.describe('Insured Information tab', () => {

    test.beforeEach(async ({ submissionOverview }) => {
      // Navigate fresh to the submission for every test
      await submissionOverview.navigateByUrl(submissionCtx.submissionUrl);
      // Wait for Overview data — ensures page is in a stable, ready state
      await submissionOverview.waitUntilLoaded();
      // Click General Information → Insured Information tab
      await submissionOverview.clickInsuredInformationTab();
    });

    // ── SMOKE ──────────────────────────────────────────────────────────────

    test(
      `${Tags.SMOKE} ${Tags.INSURED} All insured fields auto-populated from creation data`,

      async ({ insuredInfoPage }) => {
        await insuredInfoPage.verifyPageLoaded();

        // Uses formData — the single source of truth from creation
        // NEVER call SubmissionFactory.default() here — it generates NEW random data
        await insuredInfoPage.assertAutoPopulatedFromSubmission(submissionCtx.formData);
      }
    );

    // ── SANITY — Individual field checks ───────────────────────────────────

    test(
      `${Tags.SANITY} ${Tags.INSURED} First Named Insured matches creation data`,

      async ({ insuredInfoPage }) => {
        await insuredInfoPage.verifyPageLoaded();
        await insuredInfoPage.assertNamedInsured(
          submissionCtx.formData.insured.namedInsured
        );
      }
    );

    test(
      `${Tags.SANITY} ${Tags.INSURED} Country matches creation data`,

      async ({ insuredInfoPage }) => {
        await insuredInfoPage.verifyPageLoaded();
        // assertCountry uses DropdownComponent.getSelectedValue() internally
        await insuredInfoPage.assertCountry(submissionCtx.formData.insured.country);
      }
    );

    test(
      `${Tags.SANITY} ${Tags.INSURED} Address fields match creation data`,

      async ({ insuredInfoPage }) => {
        await insuredInfoPage.verifyPageLoaded();
        await insuredInfoPage.assertStreetAddress(submissionCtx.formData.insured.streetAddress);
        await insuredInfoPage.assertCity(submissionCtx.formData.insured.city);
        await insuredInfoPage.assertState(submissionCtx.formData.insured.state);
        await insuredInfoPage.assertZip(submissionCtx.formData.insured.zip);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.INSURED} "+ Add Named Insured" button is visible`,

      async ({ insuredInfoPage }) => {
        await insuredInfoPage.verifyPageLoaded();
        await insuredInfoPage.assertAddNamedInsuredButtonVisible();
      }
    );

    // ── REGRESSION — Edit tests (run after auto-population checks) ─────────

    test(
      `${Tags.REGRESSION} ${Tags.INSURED} Can update Named Insured — value saves`,

      async ({ insuredInfoPage }) => {
        await insuredInfoPage.verifyPageLoaded();
        const updatedName = 'UPDATED-Company 999';
        await insuredInfoPage.fillNamedInsured(updatedName);
        await insuredInfoPage.assertNamedInsured(updatedName);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.INSURED} Country change to Canada updates State list`,

      async ({ insuredInfoPage }) => {
        await insuredInfoPage.verifyPageLoaded();
        // DropdownComponent.select() handles open + click
        await insuredInfoPage.selectCountry('Canada');
        await insuredInfoPage.assertCountry('Canada');
        // State list now shows Canadian provinces
        await insuredInfoPage.selectState('Ontario');
        await insuredInfoPage.assertState('Ontario');
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.INSURED} Required error appears when Named Insured is cleared`,

      async ({ insuredInfoPage }) => {
        await insuredInfoPage.verifyPageLoaded();
        await insuredInfoPage.fillNamedInsured('');
        await insuredInfoPage.assertNamedInsuredRequired();
      }
    );

    // ── Guest Role ──────────────────────────────────────────────────────────

    test.describe('Guest Role', () => {
      test.use({ role: Role.GUEST });

      test(
        `${Tags.REGRESSION} ${Tags.GUEST} Insured fields are disabled for Guest`,

        async ({ insuredInfoPage }) => {
          await insuredInfoPage.verifyPageLoaded();
          await expect(
            insuredInfoPage['firstNamedInsuredInput'],
            'Named Insured should be disabled for Guest role'
          ).toBeDisabled();
        }
      );
    });
  });

  // ════════════════════════════════════════════════════════════════════════
  // TAB 2 — POLICY INFORMATION
  // ════════════════════════════════════════════════════════════════════════

  test.describe('Policy Information tab', () => {

    test.beforeEach(async ({ submissionOverview }) => {
      await submissionOverview.navigateByUrl(submissionCtx.submissionUrl);
      await submissionOverview.waitUntilLoaded();
      await submissionOverview.clickPolicyInformationTab();
    });

    // ── SMOKE ──────────────────────────────────────────────────────────────

    test(
      `${Tags.SMOKE} ${Tags.POLICY} All policy fields auto-populated from creation data`,

      async ({ policyInfoPage }) => {
        await policyInfoPage.verifyPageLoaded();
        await policyInfoPage.assertAutoPopulatedFromSubmission(submissionCtx.formData);
      }
    );

    // ── SANITY — Individual field checks ───────────────────────────────────

    test(
      `${Tags.SANITY} ${Tags.POLICY} Submission Number matches creation data`,

      async ({ policyInfoPage }) => {
        await policyInfoPage.verifyPageLoaded();
        await policyInfoPage.assertSubmissionNumber(
          submissionCtx.formData.submissionNumber
        );
      }
    );

    test(
      `${Tags.SANITY} ${Tags.POLICY} Inception Date matches creation data`,

      async ({ policyInfoPage }) => {
        await policyInfoPage.verifyPageLoaded();
        await policyInfoPage.assertInceptionDate(
          submissionCtx.formData.inceptionDate
        );
      }
    );

    test(
      `${Tags.SANITY} ${Tags.POLICY} Expiration Date auto-calculated as Inception + 1 year`,

      async ({ policyInfoPage }) => {
        await policyInfoPage.verifyPageLoaded();
        // DateHelper calculates the expected expiration — consistent with the application
        await policyInfoPage.assertExpirationAutoCalculated(
          submissionCtx.formData.inceptionDate
        );
      }
    );

    test(
      `${Tags.SANITY} ${Tags.POLICY} Policy Type matches creation data`,

      async ({ policyInfoPage }) => {
        await policyInfoPage.verifyPageLoaded();
        await policyInfoPage.assertPolicyType(submissionCtx.formData.policyType);
      }
    );

    // ── REGRESSION — Policy Number constraints ──────────────────────────────

    test(
      `${Tags.REGRESSION} ${Tags.POLICY} Policy Number accepts 14 characters (max allowed)`,

      async ({ policyInfoPage }) => {
        await policyInfoPage.verifyPageLoaded();
        await policyInfoPage.assertPolicyNumberAccepts14Chars();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.POLICY} Policy Number rejects 15+ characters`,

      async ({ policyInfoPage }) => {
        await policyInfoPage.verifyPageLoaded();
        await policyInfoPage.assertPolicyNumberRejectsOver14Chars();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.POLICY} Can save a valid Policy Number`,

      async ({ policyInfoPage }) => {
        await policyInfoPage.verifyPageLoaded();
        await policyInfoPage.fillPolicyNumber('POL2026001234'); // 13 chars — valid
        await policyInfoPage.assertPolicyNumber('POL2026001234');
      }
    );

    // ── REGRESSION — Renewal-specific behavior ──────────────────────────────
    // These require a Renewal submission — creates its own context separately
    // because the outer submissionCtx is for a "New" policy type.

    test.describe('Renewal Policy — separate submission', () => {
      let renewalCtx!: SubmissionContext;

      test.beforeAll(async ({ browser }) => {
        // Create a second submission with policyType = Renewal
        const { SubmissionFactory } = await import('../../src/data/factories/SubmissionFactory');
        const context = await browser.newContext({
          storageState: (await import('../../src/auth/StorageStateManager')).StorageStateManager.getFilePath(Role.UW),
          viewport: { width: 1920, height: 1080 },
        });
        const page = await context.newPage();
        try {
          const formData = SubmissionFactory.renewal();
          const dash  = new (await import('../../src/pages/DashboardPage')).DashboardPage(page);
          const modal = new (await import('../../src/pages/NewSubmissionModal')).NewSubmissionModal(page);
          await dash.navigate();
          await dash.clickNewSubmission();
          await modal.verifyPageLoaded();
          const newTab = await modal.createSubmission(formData, context);
          const url    = newTab.url();
          const { UrlHelper } = await import('../../src/helpers/UrlHelper');
          renewalCtx = {
            metrixSubmissionId: UrlHelper.extractMetrixSubmissionId(url),
            displayId:          UrlHelper.extractDisplayId(url),
            submissionUrl:      url,
            formData,
          };
        } finally {
          await context.close();
        }
      });

      test(
        `${Tags.REGRESSION} ${Tags.POLICY} Renewal — PY Pricing Summary button is visible`,

        async ({ submissionOverview, policyInfoPage }) => {
          await submissionOverview.navigateByUrl(renewalCtx.submissionUrl);
          await submissionOverview.waitUntilLoaded();
          await submissionOverview.clickPolicyInformationTab();
          await policyInfoPage.verifyPageLoaded();
          await policyInfoPage.assertPYPricingSummaryVisible();
        }
      );

      test(
        `${Tags.REGRESSION} ${Tags.POLICY} New policy — PY Pricing Summary button is hidden`,

        async ({ policyInfoPage }) => {
          // Uses the outer submissionCtx (New policy type)
          await policyInfoPage.verifyPageLoaded();
          await policyInfoPage.assertPYPricingSummaryHidden();
        }
      );
    });

    // ── Guest Role ──────────────────────────────────────────────────────────

    test.describe('Guest Role', () => {
      test.use({ role: Role.GUEST });

      test(
        `${Tags.REGRESSION} ${Tags.GUEST} Policy Number is disabled for Guest`,

        async ({ policyInfoPage }) => {
          await policyInfoPage.verifyPageLoaded();
          await expect(
            policyInfoPage['policyNumberInput'],
            'Policy Number should be disabled for Guest role'
          ).toBeDisabled();
        }
      );
    });
  });

  // ════════════════════════════════════════════════════════════════════════
  // TAB 3 — BROKER INFORMATION
  // ════════════════════════════════════════════════════════════════════════

  test.describe('Broker Information tab', () => {

    test.beforeEach(async ({ submissionOverview }) => {
      await submissionOverview.navigateByUrl(submissionCtx.submissionUrl);
      await submissionOverview.waitUntilLoaded();
      await submissionOverview.clickBrokerInformationTab();
    });

    // ── SMOKE ──────────────────────────────────────────────────────────────

    test(
      `${Tags.SMOKE} ${Tags.BROKER} All broker fields auto-populated from creation data`,

      async ({ brokerInfoPage }) => {
        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.assertAutoPopulatedFromSubmission(submissionCtx.formData);
      }
    );

    // ── SANITY — Individual field checks ───────────────────────────────────

    test(
      `${Tags.SANITY} ${Tags.BROKER} Broker Company matches creation data`,

      async ({ brokerInfoPage }) => {
        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.assertBrokerCompany(
          submissionCtx.formData.broker.brokerCompany
        );
      }
    );

    test(
      `${Tags.SANITY} ${Tags.BROKER} Broker Country defaults to USA`,

      async ({ brokerInfoPage }) => {
        await brokerInfoPage.verifyPageLoaded();
        // assertDefaultCountry uses DropdownComponent.getSelectedValue() internally
        await brokerInfoPage.assertDefaultCountry();
      }
    );

    test(
      `${Tags.SANITY} ${Tags.BROKER} Broker address fields match creation data`,

      async ({ brokerInfoPage }) => {
        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.assertStreetAddress(submissionCtx.formData.broker.streetAddress);
        await brokerInfoPage.assertCity(submissionCtx.formData.broker.city);
        await brokerInfoPage.assertState(submissionCtx.formData.broker.state);
        await brokerInfoPage.assertZip(submissionCtx.formData.broker.zip);
      }
    );

    // ── REGRESSION — Email validation ───────────────────────────────────────

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Valid email — no error shown`,

      async ({ brokerInfoPage }) => {
        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.fillEmail('valid@company.com');
        await brokerInfoPage.assertNoEmailValidationError();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Invalid email (no @) — error shown`,

      async ({ brokerInfoPage }) => {
        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.fillEmail('invalidemail.com');
        await brokerInfoPage.assertEmailValidationError();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Fixing invalid email clears the error`,

      async ({ brokerInfoPage }) => {
        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.fillEmail('bademail');
        await brokerInfoPage.assertEmailValidationError();
        await brokerInfoPage.fillEmail('fixed@company.com');
        await brokerInfoPage.assertNoEmailValidationError();
      }
    );

    // ── REGRESSION — Commission validation ─────────────────────────────────

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Commission = 100 is valid`,

      async ({ brokerInfoPage }) => {
        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.fillCommission(100);
        await brokerInfoPage.assertNoCommissionValidationError();
        await brokerInfoPage.assertCommission(100);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Commission = 101 shows error`,

      async ({ brokerInfoPage }) => {
        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.fillCommission(101);
        await brokerInfoPage.assertCommissionValidationError();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Commission = 0 is valid`,

      async ({ brokerInfoPage }) => {
        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.fillCommission(0);
        await brokerInfoPage.assertNoCommissionValidationError();
      }
    );

    // ── REGRESSION — Character counter (2000 → 0) ──────────────────────────

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Counter starts at 2000 when field is empty`,

      async ({ brokerInfoPage }) => {
        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.clearBrokerNotes();
        await brokerInfoPage.assertCounterAtMaximum();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Typing 50 chars → counter shows 1950`,

      async ({ brokerInfoPage }) => {
        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.clearBrokerNotes();
        await brokerInfoPage.fillBrokerNotes('A'.repeat(50));
        await brokerInfoPage.assertCounterAfterTyping(50);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Counter reaches 0 at 2000 characters`,

      async ({ brokerInfoPage }) => {
        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.clearBrokerNotes();
        await brokerInfoPage.fillBrokerNotes('C'.repeat(2000));
        await brokerInfoPage.assertCounterAtZero();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Counter resets to 2000 after clearing`,

      async ({ brokerInfoPage }) => {
        await brokerInfoPage.verifyPageLoaded();
        await brokerInfoPage.fillBrokerNotes('Some notes');
        await brokerInfoPage.clearBrokerNotes();
        await brokerInfoPage.assertCounterAtMaximum();
      }
    );

    // ── Guest Role ──────────────────────────────────────────────────────────

    test.describe('Guest Role', () => {
      test.use({ role: Role.GUEST });

      test(
        `${Tags.REGRESSION} ${Tags.GUEST} Broker fields are disabled for Guest`,

        async ({ brokerInfoPage }) => {
          await brokerInfoPage.verifyPageLoaded();
          await expect(brokerInfoPage['brokerCompanyInput']).toBeDisabled();
          await expect(brokerInfoPage['emailInput']).toBeDisabled();
          await expect(brokerInfoPage['commissionInput']).toBeDisabled();
        }
      );
    });
  });
});
