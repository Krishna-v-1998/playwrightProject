import { test, expect }      from '../../src/fixtures/index';
import { Tags }              from '../../src/constants/test-tags.constants';
import { Role }              from '../../src/enums/role.enum';
import { SubmissionFactory } from '../../src/data/factories/SubmissionFactory';
import { SubmissionManager } from '../../src/data/managers/SubmissionManager';
import { UrlHelper }         from '../../src/helpers/UrlHelper';

test.use({ role: Role.UW });

test.describe('Submission Overview — Top Bar Validation', () => {

  /**
   * FIXTURE PATTERN EXPLAINED:
   *
   * All fixtures (submissionOverview, insuredInfoPage, brokerInfoPage, policyInfoPage)
   * share the SAME 'authenticatedPage' reference.
   *
   * After submission creation:
   *   newTab = a different browser tab (the one that opened automatically)
   *   We navigate 'authenticatedPage' to the submission URL.
   *   Then all fixtures automatically point to that submission.
   *
   * We NEVER create: new SubmissionOverviewPage(newTab)
   * We ALWAYS use:   submissionOverview (the fixture)
   */

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 1 — Create NOW → navigate fixture page → verify
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Validate after submission creation', () => {

    test.beforeEach(async ({ dashboardPage }) => {
      await dashboardPage.navigate();
    });

    test(
      `${Tags.SMOKE} ${Tags.SUBMISSION} ${Tags.OVERVIEW} `
      + 'Create submission → all top bar fields match creation data',

      async ({
        dashboardPage,
        newSubmissionModal,
        authenticatedPage,
        submissionOverview,    // ← fixture, wraps authenticatedPage
      }) => {

        const data = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        await newSubmissionModal.verifyPageLoaded();

        // Step 1: Create — a new browser tab opens automatically
        const newTab = await newSubmissionModal.createSubmission(
          data,
          authenticatedPage.context(),
        );

        // Step 2: Extract IDs from the new tab URL
        const url                = newTab.url();
        const metrixSubmissionId = UrlHelper.extractMetrixSubmissionId(url);
        const displayId          = UrlHelper.extractDisplayId(url);

        expect(metrixSubmissionId, `Could not extract ID from: ${url}`).not.toBe('');

        // Step 3: Store for other spec files
        SubmissionManager.store({
          metrixSubmissionId,
          displayId,
          submissionUrl:    url,
          quoteId:          '',
          submissionNumber: data.submissionNumber,
          namedInsured:     data.insured.namedInsured,
          createdAt:        Date.now(),
          environment:      process.env.ENVIRONMENT ?? 'qa',
        });

        // Step 4: Navigate the FIXTURE's page to the submission URL
        // Now 'submissionOverview' is on the submission page — no new object needed
        await submissionOverview.navigateByUrl(url);

        // Step 5: Wait for Phase 1 (DOM) to be ready
        await submissionOverview.verifyPageLoaded();

        // Step 6: Wait for Phase 2 (real API data) to load
        // THE KEY FIX — waits until Named Insured shows the real value, not placeholder
        await submissionOverview.waitForDataLoaded(data.insured.namedInsured);

        // Step 7: Assert all top bar fields — data is now loaded
        await submissionOverview.assertTopBarMatchesSubmissionData(data);
      }
    );

    test(
      `${Tags.SANITY} ${Tags.OVERVIEW} Named Insured matches creation data`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage, submissionOverview }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        await submissionOverview.navigateByUrl(newTab.url());
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.waitForDataLoaded(data.insured.namedInsured);
        await submissionOverview.assertNamedInsured(data.insured.namedInsured);
      }
    );

    test(
      `${Tags.SANITY} ${Tags.OVERVIEW} Status defaults to Open`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage, submissionOverview }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        await submissionOverview.navigateByUrl(newTab.url());
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.waitForDataLoaded(data.insured.namedInsured);
        await submissionOverview.assertDefaultStatus();
      }
    );

    test(
      `${Tags.SANITY} ${Tags.OVERVIEW} Policy Number defaults to None`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage, submissionOverview }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        await submissionOverview.navigateByUrl(newTab.url());
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.waitForDataLoaded(data.insured.namedInsured);
        await submissionOverview.assertPolicyNumber('None');
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.OVERVIEW} Submission Number matches creation data`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage, submissionOverview }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        await submissionOverview.navigateByUrl(newTab.url());
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.waitForDataLoaded(data.insured.namedInsured);
        await submissionOverview.assertSubmissionNumber(data.submissionNumber);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.OVERVIEW} Current Assignee matches Underwriter`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage, submissionOverview }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        await submissionOverview.navigateByUrl(newTab.url());
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.waitForDataLoaded(data.insured.namedInsured);
        await submissionOverview.assertCurrentAssigneeMatchesUnderwriter();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.OVERVIEW} Sidebar navigation is visible`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage, submissionOverview }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        await submissionOverview.navigateByUrl(newTab.url());
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.waitForDataLoaded(data.insured.namedInsured);
        await submissionOverview.assertSidebarVisible();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.OVERVIEW} Dashboard table shows new submission`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const data = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        // Dashboard is still on authenticatedPage (we haven't navigated away)
        await dashboardPage.assertSubmissionInTable(data.submissionNumber);
      }
    );
  });

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 2 — Navigate to stored submission using fixtures
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Validate stored submission via direct navigation', () => {

    test(
      `${Tags.REGRESSION} ${Tags.OVERVIEW} Named Insured matches stored value`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission. Run smoke test first.'); return; }

        await submissionOverview.navigateByUrl(stored.submissionUrl);
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.waitForDataLoaded(stored.namedInsured);
        await submissionOverview.assertNamedInsured(stored.namedInsured);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.OVERVIEW} Submission Number matches stored value`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await submissionOverview.navigateByUrl(stored.submissionUrl);
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.waitForDataLoaded(stored.namedInsured);
        await submissionOverview.assertSubmissionNumber(stored.submissionNumber);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.OVERVIEW} Status is still Open`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await submissionOverview.navigateByUrl(stored.submissionUrl);
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.waitForDataLoaded(stored.namedInsured);
        await submissionOverview.assertDefaultStatus();
      }
    );
  });

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 3 — Guest Role
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Guest Role', () => {

    test.use({ role: Role.GUEST });

    test(
      `${Tags.REGRESSION} ${Tags.GUEST} New Submission button hidden for Guest`,

      async ({ dashboardPage }) => {
        await dashboardPage.navigate();
        await dashboardPage.assertNewSubmissionButtonHidden();
      }
    );
  });
});
