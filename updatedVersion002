  async getNamedInsured():   Promise<string> { return this.firstNamedInsuredInput.inputValue(); }
  async getStreetAddress():  Promise<string> { return this.streetAddressInput.inputValue(); }
  async getStreetAddress2(): Promise<string> { return this.streetAddress2Input.inputValue(); }
