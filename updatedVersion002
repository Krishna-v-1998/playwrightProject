/**
 * Wait for the Exposures & Quotes page to be ready.
 *
 * HOW IT WORKS (simple explanation):
 *   1. waitForLoadState('networkidle') — browser stopped all background calls
 *      Like: the webpage finished downloading everything it needs
 *
 *   2. pageLoadedIndicator.waitFor({ state: 'visible' }) — the main element appeared
 *      Like: you can actually see the "Exposures & Quotes" content on screen
 *
 * WHY THIS IS BETTER THAN SPINNER:
 *   Spinner = waiting for something to GO AWAY (unreliable — may never appear)
 *   waitFor = waiting for something to SHOW UP   (reliable — clear success condition)
 */
async verifyPageLoaded(): Promise<void> {
  // Step 1: Wait for all network calls to finish
  await this.page.waitForLoadState('networkidle');

  // Step 2: Wait for a specific visible element to confirm the page is ready
  // Replace 'YOUR_EXPOSURES_PAGE_LOADED_INDICATOR' with the selector of
  // any element that is ALWAYS visible on the Exposures & Quotes page
  // e.g. the "Quote" tab button, or the "Add New" button, or the page heading
  await this.pageLoadedIndicator.waitFor({
    state:   'visible',  // wait until it appears on screen
    timeout: 15_000,     // fail if not visible within 15 seconds
  });

  this.log('Exposures & Quotes page loaded');
}
