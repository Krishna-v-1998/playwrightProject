/**
 * BrokerInformationPage
 *
 * ── WHAT THIS IS ──────────────────────────────────────────────────────────────
 * This handles the "Broker Information" tab inside General Information.
 *
 * Think of it as the third tab where you see who the broker is:
 *   - The broker company name
 *   - Their address
 *   - Their email and commission percentage
 *   - Notes about the broker (limited to 2000 characters)
 *
 * ── HOW TO GET HERE ───────────────────────────────────────────────────────────
 *   const overview   = new SubmissionOverviewPage(submissionTab);
 *   await overview.clickBrokerInformationTab();
 *   const brokerPage = new BrokerInformationPage(submissionTab);
 *
 * ── WHAT YOU SEE ON SCREEN ────────────────────────────────────────────────────
 *   BROKER COMPANY *    [AUTOMATION-BrightPath Consulting 7]
 *   WINS NUMBER         [auto-filled]
 *   COUNTRY *           [USA ▼]
 *   STREET ADDRESS *    [...]
 *   STREET ADDRESS 2    [...]
 *   CITY *              [...]
 *   STATE/PROVINCE *    [▼]
 *   ZIP/POSTAL CODE *   [...]
 *   BROKER CONTACT      [Type...]
 *   EMAIL               [Type...]   ← validates email format
 *   COMMISSION (%)      [Type...]   ← must be 0-100
 *   BROKER REVIEW/NOTES [Rich text] ← max 2000 chars, counter shows remaining
 *   UNDERWRITING RATIONAL [Rich text]
 *
 * ── KEY BUSINESS RULES ────────────────────────────────────────────────────────
 *   1. Email must be valid format (user@domain.com)
 *   2. Commission: number between 0-100 (101+ shows error)
 *   3. Broker Notes: max 2000 characters
 *      - Counter starts at 2000 (empty field)
 *      - As you type, it counts DOWN: 2000 → 1999 → ... → 0
 *
 * ── SETUP REQUIRED ────────────────────────────────────────────────────────────
 * Replace all YOUR_*_SELECTOR with actual selectors.
 */
export class BrokerInformationPage extends BasePage {

  // ── Page Ready Indicator ───────────────────────────────────────────────────
  private readonly brokerCompanyInput: Locator;

  // ── Broker Details ─────────────────────────────────────────────────────────
  private readonly winsNumberInput:    Locator;
  private readonly brokerContactInput: Locator;
  private readonly emailInput:         Locator;
  private readonly commissionInput:    Locator;

  // ── Address ────────────────────────────────────────────────────────────────
  private readonly countryContainer:   Locator;
  private readonly countryInput:       Locator;
  private readonly streetAddressInput: Locator;
  private readonly streetAddress2Input: Locator;
  private readonly cityInput:          Locator;
  private readonly stateContainer:     Locator;
  private readonly stateInput:         Locator;
  private readonly zipInput:           Locator;

  // ── Rich Text Fields ───────────────────────────────────────────────────────
  // Broker Notes — max 2000 chars with live countdown counter
  private readonly brokerNotesEditor:    Locator;
  private readonly uwRationaleEditor:    Locator;

  // ── Character Counter ──────────────────────────────────────────────────────
  // Shows how many characters REMAIN (starts at 2000, counts DOWN to 0)
  // Example display: "1950 characters remaining"
  private readonly characterCounter:    Locator;

  // ── Validation Errors ──────────────────────────────────────────────────────
  private readonly emailError:          Locator;
  private readonly commissionError:     Locator;

  constructor(page: Page) {
    super(page);

    this.brokerCompanyInput  = page.locator('YOUR_BROKER_COMPANY_INPUT');
    this.winsNumberInput     = page.locator('YOUR_BROKER_WINS_NUMBER_INPUT');
    this.brokerContactInput  = page.locator('YOUR_BROKER_CONTACT_INPUT');
    this.emailInput          = page.locator('YOUR_BROKER_EMAIL_INPUT');
    this.commissionInput     = page.locator('YOUR_BROKER_COMMISSION_INPUT');

    this.countryContainer    = page.locator('YOUR_BROKER_COUNTRY_CONTAINER');
    this.countryInput        = page.locator('YOUR_BROKER_COUNTRY_INPUT');
    this.streetAddressInput  = page.locator('YOUR_BROKER_STREET_ADDRESS_INPUT');
    this.streetAddress2Input = page.locator('YOUR_BROKER_STREET_ADDRESS_2_INPUT');
    this.cityInput           = page.locator('YOUR_BROKER_CITY_INPUT');
    this.stateContainer      = page.locator('YOUR_BROKER_STATE_CONTAINER');
    this.stateInput          = page.locator('YOUR_BROKER_STATE_INPUT');
    this.zipInput            = page.locator('YOUR_BROKER_ZIP_INPUT');

    this.brokerNotesEditor   = page.locator('YOUR_BROKER_NOTES_EDITOR_SELECTOR');
    this.uwRationaleEditor   = page.locator('YOUR_BROKER_UW_RATIONALE_SELECTOR');
    this.characterCounter    = page.locator('YOUR_BROKER_NOTES_CHARACTER_COUNTER');

    this.emailError          = page.locator('YOUR_BROKER_EMAIL_ERROR_SELECTOR');
    this.commissionError     = page.locator('YOUR_BROKER_COMMISSION_ERROR_SELECTOR');
  }

  // ── Page Load Check ────────────────────────────────────────────────────────

  /**
   * HOW THIS WORKS (simple explanation):
   *   1. waitForLoadState('networkidle') — browser finished all background calls
   *   2. brokerCompanyInput.waitFor('visible') — the Broker Company field appeared
   *
   * We use brokerCompanyInput because it's always on screen on this tab
   * and it's always auto-filled from the submission creation, so it's
   * a reliable signal that the tab has fully loaded.
   */
  async verifyPageLoaded(): Promise<void> {
    await this.page.waitForLoadState('networkidle');

    await this.brokerCompanyInput.waitFor({
      state:   'visible',
      timeout: 15_000,
    });

    this.log('Broker Information tab loaded');
  }

  async getPageTitle(): Promise<string> { return this.page.title(); }

  // ── Read Field Values ──────────────────────────────────────────────────────

  async getBrokerCompany():  Promise<string> { return (await this.brokerCompanyInput.inputValue()).trim(); }
  async getWinsNumber():     Promise<string> { return (await this.winsNumberInput.inputValue()).trim(); }
  async getEmail():          Promise<string> { return (await this.emailInput.inputValue()).trim(); }
  async getCommission():     Promise<string> { return (await this.commissionInput.inputValue()).trim(); }
  async getStreetAddress():  Promise<string> { return (await this.streetAddressInput.inputValue()).trim(); }
  async getCity():           Promise<string> { return (await this.cityInput.inputValue()).trim(); }
  async getZip():            Promise<string> { return (await this.zipInput.inputValue()).trim(); }

  /**
   * Reads the character counter number.
   *
   * HOW IT WORKS:
   *   The counter element shows text like "1950 characters remaining"
   *   We extract just the NUMBER from that text.
   *
   * EXAMPLE:
   *   Counter text: "1950 characters remaining"
   *   This method returns: 1950
   */
  async getRemainingCharacterCount(): Promise<number> {
    const text  = (await this.characterCounter.innerText()).trim();
    const match = text.match(/(\d+)/); // extract first number from text
    return match ? parseInt(match[1], 10) : 0;
  }

  // ── Fill / Update Field Values ─────────────────────────────────────────────

  async fillBrokerCompany(name: string): Promise<void> {
    await this.brokerCompanyInput.clear();
    await this.brokerCompanyInput.fill(name);
    await this.brokerCompanyInput.press('Tab');
    this.log(`Filled Broker Company: ${name}`);
  }

  async fillWinsNumber(wins: string): Promise<void> {
    await this.winsNumberInput.clear();
    await this.winsNumberInput.fill(wins);
    await this.winsNumberInput.press('Tab');
  }

  async fillBrokerContact(contact: string): Promise<void> {
    await this.brokerContactInput.clear();
    await this.brokerContactInput.fill(contact);
    await this.brokerContactInput.press('Tab');
  }

  /**
   * Types an email address into the Email field.
   * Pressing Tab triggers BOTH auto-save AND email format validation.
   *
   * VALID:   user@company.com     → no error shown
   * INVALID: notanemail           → error: "Email must be a valid email"
   * INVALID: user@               → error: "Email must be a valid email"
   */
  async fillEmail(email: string): Promise<void> {
    await this.emailInput.clear();
    await this.emailInput.fill(email);
    await this.emailInput.press('Tab'); // triggers validation
    this.log(`Filled Email: ${email}`);
  }

  /**
   * Types a commission percentage.
   *
   * BUSINESS RULES:
   *   0 to 100 = valid (no error)
   *   101+ = error: commission must be ≤ 100
   *
   * EXAMPLES:
   *   await brokerPage.fillCommission(15);   ← valid
   *   await brokerPage.fillCommission(100);  ← valid (max)
   *   await brokerPage.fillCommission(101);  ← invalid → error shows
   */
  async fillCommission(value: number): Promise<void> {
    await this.commissionInput.clear();
    await this.commissionInput.fill(String(value)); // convert number to string
    await this.commissionInput.press('Tab');
    this.log(`Filled Commission: ${value}%`);
  }

  async selectCountry(country: string): Promise<void> {
    await this.countryContainer.click();
    await this.page.waitForTimeout(400);
    await this.page.locator(`[role="option"]:has-text("${country}")`).first().click();
    await this.page.waitForLoadState('networkidle');
    this.log(`Selected Country: ${country}`);
  }

  async fillStreetAddress(address: string): Promise<void> {
    await this.streetAddressInput.clear();
    await this.streetAddressInput.fill(address);
    await this.streetAddressInput.press('Tab');
  }

  async fillCity(city: string): Promise<void> {
    await this.cityInput.clear();
    await this.cityInput.fill(city);
    await this.cityInput.press('Tab');
  }

  async selectState(state: string): Promise<void> {
    await this.stateContainer.click();
    await this.page.waitForTimeout(400);
    await this.page.locator(`[role="option"]:has-text("${state}")`).first().click();
    this.log(`Selected State: ${state}`);
  }

  async fillZip(zip: string): Promise<void> {
    await this.zipInput.clear();
    await this.zipInput.fill(zip);
    await this.zipInput.press('Tab');
  }

  /**
   * Types into the Broker Notes rich text editor.
   *
   * BUSINESS RULE: Max 2000 characters.
   * As you type, the counter COUNTS DOWN:
   *   Empty field → "2000 characters remaining"
   *   Type 50 chars → "1950 characters remaining"
   *   Type 2000 chars → "0 characters remaining"
   *
   * WHAT IS A RICH TEXT EDITOR?
   *   It's like a mini Word document inside a web page.
   *   It's NOT a normal input field — it uses a special div with contenteditable.
   *   That's why we click() first then fill() differently.
   */
  async fillBrokerNotes(text: string): Promise<void> {
    await this.brokerNotesEditor.click();
    await this.brokerNotesEditor.fill(text);
    this.log(`Filled Broker Notes: ${text.length} characters`);
  }

  async clearBrokerNotes(): Promise<void> {
    await this.brokerNotesEditor.click();
    await this.brokerNotesEditor.press('Control+a');
    await this.brokerNotesEditor.press('Delete');
    this.log('Cleared Broker Notes');
  }

  async fillUWRationale(text: string): Promise<void> {
    await this.uwRationaleEditor.click();
    await this.uwRationaleEditor.fill(text);
    this.log('Filled UW Rationale');
  }

  // ── Assert Field Values ────────────────────────────────────────────────────

  async assertBrokerCompany(expected: string): Promise<void> {
    await expect(
      this.brokerCompanyInput,
      `Broker Company should be "${expected}"`
    ).toHaveValue(expected);
    this.log(`✅ Broker Company: ${expected}`);
  }

  async assertWinsNumber(expected: string): Promise<void> {
    await expect(this.winsNumberInput).toHaveValue(expected);
    this.log(`✅ WINS Number: ${expected}`);
  }

  async assertEmail(expected: string): Promise<void> {
    await expect(this.emailInput).toHaveValue(expected);
    this.log(`✅ Email: ${expected}`);
  }

  async assertCommission(expected: number): Promise<void> {
    await expect(this.commissionInput).toHaveValue(String(expected));
    this.log(`✅ Commission: ${expected}%`);
  }

  async assertCountry(expected: string): Promise<void> {
    const actual = (await this.countryInput.inputValue()).trim();
    expect(actual, `Country: expected "${expected}" got "${actual}"`).toBe(expected);
    this.log(`✅ Country: ${expected}`);
  }

  async assertDefaultCountry(): Promise<void> {
    await this.assertCountry('USA');
  }

  async assertStreetAddress(expected: string): Promise<void> {
    await expect(this.streetAddressInput).toHaveValue(expected);
    this.log(`✅ Street Address: ${expected}`);
  }

  async assertCity(expected: string): Promise<void> {
    await expect(this.cityInput).toHaveValue(expected);
    this.log(`✅ City: ${expected}`);
  }

  async assertState(expected: string): Promise<void> {
    const actual = (await this.stateInput.inputValue()).trim();
    expect(actual, `State: expected "${expected}" got "${actual}"`).toBe(expected);
    this.log(`✅ State: ${expected}`);
  }

  async assertZip(expected: string): Promise<void> {
    await expect(this.zipInput).toHaveValue(expected);
    this.log(`✅ Zip: ${expected}`);
  }

  // ── Email Validation Assertions ────────────────────────────────────────────

  /**
   * Checks the "Email must be a valid email" error IS showing.
   * Call this AFTER fillEmail() with an invalid email.
   */
  async assertEmailValidationError(): Promise<void> {
    await expect(
      this.emailError,
      'Email error message should appear for invalid email'
    ).toBeVisible();
    await expect(this.emailError).toContainText('valid email');
    this.log('✅ Email validation error shown');
  }

  /**
   * Checks the email error is NOT showing.
   * Call this AFTER fillEmail() with a valid email.
   */
  async assertNoEmailValidationError(): Promise<void> {
    await expect(
      this.emailError,
      'Email error should NOT appear for valid email'
    ).toBeHidden();
    this.log('✅ No email validation error');
  }

  // ── Commission Validation Assertions ──────────────────────────────────────

  async assertCommissionValidationError(): Promise<void> {
    await expect(
      this.commissionError,
      'Commission error should appear for value > 100'
    ).toBeVisible();
    this.log('✅ Commission validation error shown');
  }

  async assertNoCommissionValidationError(): Promise<void> {
    await expect(
      this.commissionError,
      'Commission error should NOT appear'
    ).toBeHidden();
    this.log('✅ No commission validation error');
  }

  // ── Character Counter Assertions ───────────────────────────────────────────

  /**
   * Checks the counter shows 2000 (field is empty).
   *
   * HOW IT WORKS:
   *   getRemainingCharacterCount() reads the number from the counter element
   *   Then we compare it to the expected value (2000)
   */
  async assertCounterAtMaximum(): Promise<void> {
    const count = await this.getRemainingCharacterCount();
    expect(
      count,
      `Counter should be 2000 (empty field) but got ${count}`
    ).toBe(2000);
    this.log('✅ Character counter at 2000 (empty field)');
  }

  /**
   * Checks the counter shows the correct number after typing.
   *
   * HOW IT WORKS:
   *   If you typed 50 characters → counter should show 1950
   *   Formula: 2000 - charsTyped = expected remaining
   *
   * EXAMPLE:
   *   await brokerPage.fillBrokerNotes('A'.repeat(100));
   *   await brokerPage.assertCounterAfterTyping(100); // expects 1900
   */
  async assertCounterAfterTyping(charsTyped: number): Promise<void> {
    const expectedRemaining = 2000 - charsTyped;
    const actualRemaining   = await this.getRemainingCharacterCount();
    expect(
      actualRemaining,
      `Counter should be ${expectedRemaining} after typing ${charsTyped} chars, got ${actualRemaining}`
    ).toBe(expectedRemaining);
    this.log(`✅ Counter: ${actualRemaining} remaining after ${charsTyped} chars`);
  }

  async assertCounterAtZero(): Promise<void> {
    const count = await this.getRemainingCharacterCount();
    expect(count, `Counter should be 0 at max but got ${count}`).toBe(0);
    this.log('✅ Character counter at 0 (max reached)');
  }

  // ── Combined: Verify auto-population from submission ──────────────────────

  async assertAutoPopulatedFromSubmission(data: SubmissionFormData): Promise<void> {
    this.log('--- Verifying Broker Information auto-population ---');

    await this.assertBrokerCompany(data.broker.brokerCompany);
    await this.assertDefaultCountry();
    await this.assertStreetAddress(data.broker.streetAddress);
    await this.assertCity(data.broker.city);
    await this.assertState(data.broker.state);
    await this.assertZip(data.broker.zip);

    if (data.broker.wins) {
      await this.assertWinsNumber(data.broker.wins);
    }

    this.log('--- Broker Information verified ✅ ---');
  }
}
