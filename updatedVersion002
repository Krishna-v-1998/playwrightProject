    this.stateContainer            = page.locator('YOUR_STATE_DROPDOWN_CONTAINER');
    this.stateInput                = page.locator('YOUR_STATE_DROPDOWN_INPUT');
    this.zipInput                  = page.locator('YOUR_ZIP_POSTAL_CODE_INPUT');
