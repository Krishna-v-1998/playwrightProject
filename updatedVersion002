    this.log('Clicked + Add Named Insured');
  }

  // ── Assert Field Values ────────────────────────────────────────────────────
  // These check that a field shows the EXPECTED value.
  // If it doesn't match, the test FAILS with a clear error message.

  async assertNamedInsured(expected: string): Promise<void> {
    // toHaveValue checks the INPUT field value
    await expect(
      this.firstNamedInsuredInput,
      `Named Insured should be "${expected}"`
    ).toHaveValue(expected);
    this.log(`✅ Named Insured: ${expected}`);
  }

  async assertStreetAddress(expected: string): Promise<void> {
    await expect(this.streetAddressInput).toHaveValue(expected);
    this.log(`✅ Street Address: ${expected}`);
  }

  async assertStreetAddress2(expected: string): Promise<void> {
    await expect(this.streetAddress2Input).toHaveValue(expected);
    this.log(`✅ Street Address 2: ${expected}`);
  }

  async assertCity(expected: string): Promise<void> {
    await expect(this.cityInput).toHaveValue(expected);
    this.log(`✅ City: ${expected}`);
  }

  async assertZip(expected: string): Promise<void> {
    await expect(this.zipInput).toHaveValue(expected);
    this.log(`✅ Zip: ${expected}`);
  }

  async assertCountry(expected: string): Promise<void> {
    const actual = (await this.countryInput.inputValue()).trim();
    expect(actual, `Country: expected "${expected}" got "${actual}"`).toBe(expected);
    this.log(`✅ Country: ${expected}`);
  }

  async assertDefaultCountry(): Promise<void> {
    await this.assertCountry('USA');
  }

  async assertState(expected: string): Promise<void> {
    const actual = (await this.stateInput.inputValue()).trim();
    expect(actual, `State: expected "${expected}" got "${actual}"`).toBe(expected);
    this.log(`✅ State: ${expected}`);
  }

  // ── Validation Error Assertions ────────────────────────────────────────────

  async assertNamedInsuredRequired(): Promise<void> {
    await expect(
      this.namedInsuredError,
      'Named Insured error should be visible'
    ).toBeVisible();
    this.log('✅ Named Insured required error shown');
  }

  async assertNoNamedInsuredError(): Promise<void> {
    await expect(this.namedInsuredError).toBeHidden();
  }

  // ── "+ Add Named Insured" Button ───────────────────────────────────────────

  async assertAddNamedInsuredButtonVisible(): Promise<void> {
    await expect(
      this.addNamedInsuredButton,
      '"+ Add Named Insured" button should be visible'
    ).toBeVisible();
    this.log('✅ Add Named Insured button visible');
  }

  // ── Combined: Verify everything was auto-populated from submission ─────────

  /**
   * ONE METHOD TO CHECK EVERYTHING.
   *
   * When a submission is created, all these fields are auto-filled
   * from what the user entered in the New Submission Modal.
   *
   * This method checks ALL fields at once so tests don't need to
   * call 10 separate assert methods.
   *
   * HOW TO USE:
   *   await insuredPage.assertAutoPopulatedFromSubmission(data);
   */
  async assertAutoPopulatedFromSubmission(data: SubmissionFormData): Promise<void> {
    this.log('--- Verifying Insured Information auto-population ---');

    // Company name
    await this.assertNamedInsured(data.insured.namedInsured);

    // Country (defaults to USA)
    await this.assertCountry(data.insured.country);

    // Address
    await this.assertStreetAddress(data.insured.streetAddress);
    if (data.insured.streetAddress2) {
      await this.assertStreetAddress2(data.insured.streetAddress2);
    }

    // City, State, Zip
    await this.assertCity(data.insured.city);
    await this.assertState(data.insured.state);
    await this.assertZip(data.insured.zip);

    // Button present
    await this.assertAddNamedInsuredButtonVisible();

    this.log('--- Insured Information verified ✅ ---');
  }
}
