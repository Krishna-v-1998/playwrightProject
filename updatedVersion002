    this.firstNamedInsuredInput    = page.locator('YOUR_FIRST_NAMED_INSURED_INPUT');
    this.countryContainer          = page.locator('YOUR_COUNTRY_DROPDOWN_CONTAINER');
    this.countryInput              = page.locator('YOUR_COUNTRY_DROPDOWN_INPUT');
    this.streetAddressInput        = page.locator('YOUR_STREET_ADDRESS_INPUT');
    this.streetAddress2Input       = page.locator('YOUR_STREET_ADDRESS_2_INPUT');
