  // ── Page Load Check ────────────────────────────────────────────────────────

  /**
   * Wait until this tab has fully loaded before doing anything.
   *
   * HOW IT WORKS (simple explanation):
   *   1. waitForLoadState('networkidle') = browser finished all network calls
   *      Think: website stopped downloading things in the background
   *   2. firstNamedInsuredInput.waitFor('visible') = the main field appeared on screen
   *      Think: the form fields are actually showing up, not just a blank page
   *
   * WHY NOT USE SPINNER:
   *   Waiting for a spinner to DISAPPEAR is unreliable — the spinner might never
   *   appear on a fast load, but the page might still not be ready.
   *   Waiting for content to APPEAR is always reliable.
   */
  async verifyPageLoaded(): Promise<void> {
    // Step 1: Wait for all background network calls to finish
    await this.page.waitForLoadState('networkidle');

    // Step 2: Wait for the first field to actually appear on screen
    await this.firstNamedInsuredInput.waitFor({
      state:   'visible',  // 'visible' means: on screen and not hidden
      timeout: 15_000,     // give it up to 15 seconds
