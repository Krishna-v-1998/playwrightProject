        // Point both page objects at the same newTab
        const overviewOnNewTab = new SubmissionOverviewPage(newTab);
        await overviewOnNewTab.verifyPageLoaded();
        await overviewOnNewTab.clickInsuredInformationTab();

        // InsuredInformationPage uses the SAME newTab reference
        const insuredOnNewTab = new InsuredInformationPage(newTab);
