        await policyPage.fillPolicyNumber(validPolicyNum);
        await policyPage.assertPolicyNumber(validPolicyNum);
      }
    );

    // ── RENEWAL POLICY TESTS ────────────────────────────────────────────────

    test(
      `${Tags.REGRESSION} ${Tags.POLICY} Renewal policy — PY Pricing Summary button is VISIBLE`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        // Create a Renewal-type submission
        const { policyPage } = await createAndNavigateToPolicyTab(
          dashboardPage, newSubmissionModal, authenticatedPage,
