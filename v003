import { test, expect }            from '../../src/fixtures/index';
import { Tags }                    from '../../src/constants/test-tags.constants';
import { Role }                    from '../../src/enums/role.enum';
import { SubmissionFactory }       from '../../src/data/factories/SubmissionFactory';
import { SubmissionManager }       from '../../src/data/managers/SubmissionManager';
import { SubmissionOverviewPage }  from '../../src/pages/SubmissionOverviewPage';
import { BrokerInformationPage }   from '../../src/pages/BrokerInformationPage';

/**
 * broker-information.spec.ts
 *
 * ── WHAT WE ARE TESTING ───────────────────────────────────────────────────────
 * The "Broker Information" tab inside General Information.
 *
 * Key things:
 *   - Broker company details auto-filled from modal
 *   - Email field has format validation
 *   - Commission must be 0-100 (error if over 100)
 *   - Broker Notes has a CHARACTER COUNTER that counts DOWN from 2000 to 0
 *
 * CHARACTER COUNTER EXPLAINED:
 *   The Broker Notes field shows a counter next to it.
 *   Empty field → counter shows "2000"
 *   You type 50 chars → counter shows "1950"
 *   You type 500 chars → counter shows "1500"
 *   You type 2000 chars → counter shows "0" (can't type more)
 */

test.use({ role: Role.UW });

test.describe('Broker Information Tab — Field Validation', () => {

  // Helper: creates submission and navigates to Broker Information tab
  async function createAndNavigateToBrokerTab(
    dashboardPage:      any,
    newSubmissionModal: any,
    authenticatedPage:  any,
  ) {
    const data = SubmissionFactory.default();
    await dashboardPage.navigate();
    await dashboardPage.clickNewSubmission();
    await newSubmissionModal.verifyPageLoaded();
    const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

    const overviewPage = new SubmissionOverviewPage(newTab);
    await overviewPage.verifyPageLoaded();
    await overviewPage.clickBrokerInformationTab();

    const brokerPage = new BrokerInformationPage(newTab);
    await brokerPage.verifyPageLoaded();

    return { data, brokerPage, newTab };
  }

  // Helper: navigate to stored submission's Broker tab
  async function openStoredBrokerTab(submissionOverview: SubmissionOverviewPage) {
    const stored = SubmissionManager.getLatest();
    if (!stored) throw new Error('No stored submission. Run new-submission.spec.ts first.');

    await submissionOverview.navigateByUrl(stored.submissionUrl);
    await submissionOverview.verifyPageLoaded();
    await submissionOverview.clickBrokerInformationTab();

    const brokerPage = new BrokerInformationPage(submissionOverview['page']);
    await brokerPage.verifyPageLoaded();

    return { brokerPage, stored };
  }

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 1 — Auto-population Validation
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Auto-population after submission creation', () => {

    // ── SMOKE TEST ──────────────────────────────────────────────────────────

    test(
      `${Tags.SMOKE} ${Tags.BROKER} `
      + 'All broker fields auto-populated from New Submission Modal data',

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const { data, brokerPage } = await createAndNavigateToBrokerTab(
          dashboardPage, newSubmissionModal, authenticatedPage,
        );

        // Checks: Broker Company, Country (USA), Street, City, State, Zip, WINS
        await brokerPage.assertAutoPopulatedFromSubmission(data);
      }
    );

    test(
      `${Tags.SANITY} ${Tags.BROKER} Broker Company matches what was entered in modal`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const { data, brokerPage } = await createAndNavigateToBrokerTab(
          dashboardPage, newSubmissionModal, authenticatedPage,
        );

        await brokerPage.assertBrokerCompany(data.broker.brokerCompany);
      }
    );

    test(
      `${Tags.SANITY} ${Tags.BROKER} Broker Country defaults to USA`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const { brokerPage } = await createAndNavigateToBrokerTab(
          dashboardPage, newSubmissionModal, authenticatedPage,
        );

        await brokerPage.assertDefaultCountry();
      }
    );

    test(
      `${Tags.SANITY} ${Tags.BROKER} Broker address fields match modal entries`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const { data, brokerPage } = await createAndNavigateToBrokerTab(
          dashboardPage, newSubmissionModal, authenticatedPage,
        );

        await brokerPage.assertStreetAddress(data.broker.streetAddress);
        await brokerPage.assertCity(data.broker.city);
        await brokerPage.assertState(data.broker.state);
        await brokerPage.assertZip(data.broker.zip);
      }
    );
  });

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 2 — Email Validation
  // All these tests use the stored submission to avoid creating a new one
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Email Field Validation', () => {

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Valid email format — no error shown`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        const { brokerPage } = await openStoredBrokerTab(submissionOverview);

        // A properly formatted email → should be accepted without error
        await brokerPage.fillEmail('valid.user@company.com');
        await brokerPage.assertNoEmailValidationError();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Email without @ symbol — shows validation error`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        const { brokerPage } = await openStoredBrokerTab(submissionOverview);

        // Missing @ = invalid email
        await brokerPage.fillEmail('invalidemail.com');
        await brokerPage.assertEmailValidationError();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Email with @ but no domain — shows error`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        const { brokerPage } = await openStoredBrokerTab(submissionOverview);

        // Has @ but no domain after it = invalid
        await brokerPage.fillEmail('user@');
        await brokerPage.assertEmailValidationError();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Plain text as email — shows error`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        const { brokerPage } = await openStoredBrokerTab(submissionOverview);

        // Just text, no email structure
        await brokerPage.fillEmail('notanemail');
        await brokerPage.assertEmailValidationError();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Fixing invalid email clears the error`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        const { brokerPage } = await openStoredBrokerTab(submissionOverview);

        // Step 1: Type invalid email → see error
        await brokerPage.fillEmail('bademail');
        await brokerPage.assertEmailValidationError();

        // Step 2: Fix it → error should disappear
        await brokerPage.fillEmail('fixed@email.com');
        await brokerPage.assertNoEmailValidationError();
      }
    );
  });

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 3 — Commission Validation (must be 0 to 100)
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Commission Field Validation', () => {

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Commission = 100 is valid (maximum allowed)`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        const { brokerPage } = await openStoredBrokerTab(submissionOverview);

        await brokerPage.fillCommission(100);
        await brokerPage.assertNoCommissionValidationError();
        await brokerPage.assertCommission(100);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Commission = 50 is valid`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        const { brokerPage } = await openStoredBrokerTab(submissionOverview);

        await brokerPage.fillCommission(50);
        await brokerPage.assertNoCommissionValidationError();
        await brokerPage.assertCommission(50);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Commission = 0 is valid (minimum)`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        const { brokerPage } = await openStoredBrokerTab(submissionOverview);

        await brokerPage.fillCommission(0);
        await brokerPage.assertNoCommissionValidationError();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Commission = 101 — shows validation error (over limit)`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        const { brokerPage } = await openStoredBrokerTab(submissionOverview);

        // 101 exceeds the maximum of 100 — should show error
        await brokerPage.fillCommission(101);
        await brokerPage.assertCommissionValidationError();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Commission = 999 — shows error`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        const { brokerPage } = await openStoredBrokerTab(submissionOverview);

        await brokerPage.fillCommission(999);
        await brokerPage.assertCommissionValidationError();
      }
    );
  });

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 4 — Character Counter for Broker Notes (2000 → 0 countdown)
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Broker Notes Character Counter (counts DOWN: 2000 → 0)', () => {

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Counter starts at 2000 when field is empty`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        const { brokerPage } = await openStoredBrokerTab(submissionOverview);

        // Make sure field is empty first
        await brokerPage.clearBrokerNotes();

        // Counter should show the maximum: 2000 characters remaining
        await brokerPage.assertCounterAtMaximum();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Counter decrements: type 50 chars → counter shows 1950`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        const { brokerPage } = await openStoredBrokerTab(submissionOverview);

        await brokerPage.clearBrokerNotes();

        // Type exactly 50 characters (letter A repeated 50 times)
        await brokerPage.fillBrokerNotes('A'.repeat(50));

        // Counter should now show 2000 - 50 = 1950
        await brokerPage.assertCounterAfterTyping(50);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Counter decrements: type 500 chars → counter shows 1500`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        const { brokerPage } = await openStoredBrokerTab(submissionOverview);

        await brokerPage.clearBrokerNotes();
        await brokerPage.fillBrokerNotes('B'.repeat(500));
        await brokerPage.assertCounterAfterTyping(500);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Counter reaches 0 at exactly 2000 characters`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        const { brokerPage } = await openStoredBrokerTab(submissionOverview);

        await brokerPage.clearBrokerNotes();

        // Fill exactly 2000 characters — the maximum
        await brokerPage.fillBrokerNotes('C'.repeat(2000));

        // Counter should now show 0 (limit reached)
        await brokerPage.assertCounterAtZero();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.BROKER} Counter resets to 2000 after clearing the field`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        const { brokerPage } = await openStoredBrokerTab(submissionOverview);

        // Type something first
        await brokerPage.fillBrokerNotes('Some text here');
        // Counter is now below 2000

        // Clear the field
        await brokerPage.clearBrokerNotes();

        // Counter should reset back to 2000
        await brokerPage.assertCounterAtMaximum();
      }
    );
  });

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 5 — Guest Role
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Guest Role — Read-Only', () => {

    test.use({ role: Role.GUEST });

    test(
      `${Tags.REGRESSION} ${Tags.GUEST} ${Tags.BROKER} Broker fields are disabled for Guest`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await submissionOverview.navigateByUrl(stored.submissionUrl);
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.clickBrokerInformationTab();

        const brokerPage = new BrokerInformationPage(submissionOverview['page']);
        await brokerPage.verifyPageLoaded();

        // Guest sees data but cannot edit any of it
        await expect(
          brokerPage['brokerCompanyInput'],
          'Broker Company should be disabled for Guest'
        ).toBeDisabled();

        await expect(
          brokerPage['emailInput'],
          'Email should be disabled for Guest'
        ).toBeDisabled();

        await expect(
          brokerPage['commissionInput'],
          'Commission should be disabled for Guest'
        ).toBeDisabled();
      }
    );
