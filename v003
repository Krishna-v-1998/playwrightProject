        // Change the inception date
        const newInceptionDate = '01/15/2027';
        await policyPage.fillInceptionDate(newInceptionDate);

        // The expiration date should auto-update to 1 year later
        const expectedExpiry = DateHelper.calculateExpirationDate(newInceptionDate);
        await policyPage.assertExpirationDate(expectedExpiry);
      }
    );

    // ── UNDERWRITING RATIONALE ──────────────────────────────────────────────

    test(
      `${Tags.REGRESSION} ${Tags.POLICY} Can type in Underwriting Rationale field`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const { policyPage } = await createAndNavigateToPolicyTab(
          dashboardPage, newSubmissionModal, authenticatedPage,
        );

        const rationaleText = 'This is a test rationale for automation purposes.';
        await policyPage.fillUnderwritingRationale(rationaleText);

        // Just verify no error occurred — rich text editors vary in how to assert
        this.log?.('UW Rationale filled successfully');
      }
    );
  });

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 2 — Navigate to stored submission → Policy Info tab
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Direct navigation using stored submission', () => {

    async function openStoredPolicyTab(submissionOverview: SubmissionOverviewPage) {
      const stored = SubmissionManager.getLatest();
      if (!stored) {
        throw new Error('No stored submission. Run new-submission.spec.ts first.');
