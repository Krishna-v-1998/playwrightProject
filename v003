import { test, expect }           from '../../src/fixtures/index';
import { Tags }                   from '../../src/constants/test-tags.constants';
import { Role }                   from '../../src/enums/role.enum';
import { SubmissionFactory }      from '../../src/data/factories/SubmissionFactory';
import { SubmissionManager }      from '../../src/data/managers/SubmissionManager';
import { SubmissionOverviewPage } from '../../src/pages/SubmissionOverviewPage';
import { UrlHelper }              from '../../src/helpers/UrlHelper';
import { DateHelper }             from '../../src/helpers/DateHelper';

/**
 * submission-overview.spec.ts
 *
 * ── WHAT WE ARE TESTING ───────────────────────────────────────────────────────
 * After creating a submission, a NEW TAB opens automatically.
 * That new tab shows a top bar with read-only information.
 * We check that EVERYTHING in that top bar matches what we entered
 * in the New Submission Modal during creation.
 *
 * ── WHAT THE TOP BAR SHOWS ────────────────────────────────────────────────────
 *   NAMED INSURED:    AUTOMATION-Aurora Enterprises
 *   SUBMISSION NO:    4061442121
 *   POLICY NO:        None              ← always 'None' for a brand new submission
 *   INCEPTION DATE:   09/08/2026
 *   BROKER:           AUTOMATION-BrightPath Consulting 7
 *   ZONE:             South
 *   CURRENT ASSIGNEE: Manisha GBO       ← matches the logged-in user or UW selected
 *   UNDERWRITER:      Manisha GBO
 *   Status:           Open ▼            ← always 'Open' for new submission
 *
 * ── HOW TESTS ARE ORGANIZED ──────────────────────────────────────────────────
 *   GROUP 1: Create submission in the test itself → verify immediately on new tab
 *   GROUP 2: Navigate to existing stored submission → verify via URL
 */

// All tests in this file run as UW role
test.use({ role: Role.UW });

test.describe('Submission Overview — Top Bar Validation', () => {

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 1 — Create submission NOW and verify it IMMEDIATELY on the new tab
  //
  // These tests create a fresh submission in each test and check it right away.
  // This is the most reliable way to test — no dependency on stored data.
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Immediate validation after submission creation', () => {

    // Go to dashboard before every test in this group
    test.beforeEach(async ({ dashboardPage }) => {
      await dashboardPage.navigate();
    });

    // ── SMOKE TEST ──────────────────────────────────────────────────────────
    // This is the most important test — if this fails, nothing else matters.
    // It creates a submission and immediately checks ALL overview fields at once.

    test(
      `${Tags.SMOKE} ${Tags.SUBMISSION} ${Tags.OVERVIEW} `
      + 'Create submission → new tab opens → all overview fields match creation data',

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        // ── Create the submission ────────────────────────────────────────────
        // SubmissionFactory.default() gives us random valid data
        // Random = every test run uses different values = no duplicate errors
        const data = SubmissionFactory.default();

        await dashboardPage.clickNewSubmission();
        await newSubmissionModal.verifyPageLoaded();

        // createSubmission() fills the form and clicks Create.
        // It WAITS for the new tab to open and returns it.
        const newTab = await newSubmissionModal.createSubmission(
          data,
          authenticatedPage.context(),
        );

        // ── Extract and store the submission IDs ─────────────────────────────
        // The new tab URL contains the metrixSubmissionId we need for navigation later
        const url                = newTab.url();
        const metrixSubmissionId = UrlHelper.extractMetrixSubmissionId(url);
        const displayId          = UrlHelper.extractDisplayId(url);

        // Log these so you can see them in the test output if something goes wrong
        console.log(`New tab URL:          ${url}`);
        console.log(`metrixSubmissionId:   ${metrixSubmissionId}`);
        console.log(`displayId:            ${displayId}`);

        // Fail immediately with a clear message if we couldn't get the ID
        expect(
          metrixSubmissionId,
          `Could not extract metrixSubmissionId from URL: ${url}\n` +
          `This usually means the URL format changed. Update UrlHelper.extractMetrixSubmissionId()`
        ).not.toBe('');

        // ── Save for other test files to reuse ───────────────────────────────
        // Other spec files (insured, policy, broker) can navigate to this submission
        // without creating a new one — saves time and avoids duplicates
        SubmissionManager.store({
          metrixSubmissionId,
          displayId,
          submissionUrl:    url,
          quoteId:          '',         // will be filled after quote is created
          submissionNumber: data.submissionNumber,
          namedInsured:     data.insured.namedInsured,
          createdAt:        Date.now(),
          environment:      process.env.ENVIRONMENT ?? 'qa',
        });

        // ── Verify the new tab is a valid submission page ────────────────────
        expect(
          UrlHelper.isSubmissionPage(url),
          `New tab should be a submission page but URL was: ${url}`
        ).toBeTruthy();

        // ── Create the overview page object ──────────────────────────────────
        // IMPORTANT: We pass 'newTab' — the NEW tab that opened.
        // NOT 'authenticatedPage' — that is the ORIGINAL dashboard tab.
        const overviewPage = new SubmissionOverviewPage(newTab);
        await overviewPage.verifyPageLoaded();

        // ── THE MAIN ASSERTION: Check everything matches ─────────────────────
        // This one method checks ALL top bar fields at once
        await overviewPage.assertTopBarMatchesSubmissionData(data);
      }
    );

    // ── INDIVIDUAL FIELD TESTS ──────────────────────────────────────────────
    // These test ONE field at a time — useful when you need to pinpoint failures

    test(
      `${Tags.SANITY} ${Tags.OVERVIEW} Named Insured on overview matches submission data`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        const overviewPage = new SubmissionOverviewPage(newTab);
        await overviewPage.verifyPageLoaded();

        // Check: the name we entered = the name showing in the top bar
        await overviewPage.assertNamedInsured(data.insured.namedInsured);
      }
    );

    test(
      `${Tags.SANITY} ${Tags.OVERVIEW} Submission Number on overview matches creation data`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        const overviewPage = new SubmissionOverviewPage(newTab);
        await overviewPage.verifyPageLoaded();

        await overviewPage.assertSubmissionNumber(data.submissionNumber);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.OVERVIEW} Policy Number defaults to "None" on new submission`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        const overviewPage = new SubmissionOverviewPage(newTab);
        await overviewPage.verifyPageLoaded();

        // Business Rule: Brand new submission always shows "None" for Policy Number
        await overviewPage.assertPolicyNumber('None');
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.OVERVIEW} Status defaults to "Open" on new submission`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        const overviewPage = new SubmissionOverviewPage(newTab);
        await overviewPage.verifyPageLoaded();

        // Business Rule: All new submissions start as "Open"
        await overviewPage.assertDefaultStatus();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.OVERVIEW} Inception Date on overview matches what was entered`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        const overviewPage = new SubmissionOverviewPage(newTab);
        await overviewPage.verifyPageLoaded();

        await overviewPage.assertInceptionDate(data.inceptionDate);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.OVERVIEW} Current Assignee matches the Underwriter`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        const overviewPage = new SubmissionOverviewPage(newTab);
        await overviewPage.verifyPageLoaded();

        // Business Rule: Current Assignee always equals the Underwriter
        await overviewPage.assertCurrentAssigneeMatchesUnderwriter();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.OVERVIEW} Left sidebar navigation links are all visible`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        const overviewPage = new SubmissionOverviewPage(newTab);
        await overviewPage.verifyPageLoaded();

        // All sidebar links should be there from the start
        await overviewPage.assertSidebarVisible();
      }
    );

    // ── SUBMISSION VARIANTS ──────────────────────────────────────────────────

    test(
      `${Tags.REGRESSION} ${Tags.OVERVIEW} Renewal submission — overview fields match`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        // SubmissionFactory.renewal() creates data where policyType = 'Renewal'
        const data   = SubmissionFactory.renewal();
        await dashboardPage.clickNewSubmission();
        const newTab = await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        const overviewPage = new SubmissionOverviewPage(newTab);
        await overviewPage.verifyPageLoaded();
        await overviewPage.assertTopBarMatchesSubmissionData(data);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.OVERVIEW} New submission appears in Dashboard table immediately`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const data = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
        await newSubmissionModal.createSubmission(data, authenticatedPage.context());

        // The original dashboard tab should now show the new submission
        await dashboardPage.assertSubmissionInTable(data.submissionNumber);
      }
    );
  });

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 2 — Navigate to an EXISTING stored submission and verify it
  //
  // These tests use the submission saved by GROUP 1.
  // They navigate directly using the stored URL — no creation needed.
  // Run these AFTER Group 1 has stored a submission.
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Direct navigation to stored submission', () => {

    test(
      `${Tags.REGRESSION} ${Tags.OVERVIEW} Navigate to stored submission — URL is valid`,

      async ({ submissionOverview }) => {

        // Get the submission stored by Group 1 (or new-submission.spec.ts)
        const stored = SubmissionManager.getLatest();

        // If no stored submission found, skip this test with a clear message
        if (!stored) {
          test.skip(
            true,
            'No stored submission found.\n' +
            'Run: npx playwright test tests/submission/new-submission.spec.ts first.\n' +
            'That test creates a submission and stores it.'
          );
          return;
        }

        // Navigate using the full stored URL — most reliable approach
        await submissionOverview.navigateByUrl(stored.submissionUrl);

        // Check we are on a valid submission page
        expect(
          UrlHelper.isSubmissionPage(submissionOverview['page'].url()),
          'After navigation, URL should be a valid submission page'
        ).toBeTruthy();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.OVERVIEW} Stored submission — Named Insured matches stored value`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await submissionOverview.navigateByUrl(stored.submissionUrl);
        await submissionOverview.verifyPageLoaded();

        // The stored namedInsured should match what we see on screen
        await submissionOverview.assertNamedInsured(stored.namedInsured);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.OVERVIEW} Stored submission — Submission Number matches`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await submissionOverview.navigateByUrl(stored.submissionUrl);
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.assertSubmissionNumber(stored.submissionNumber);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.OVERVIEW} Stored submission — Status is still Open`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await submissionOverview.navigateByUrl(stored.submissionUrl);
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.assertDefaultStatus();
      }
    );
  });

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 3 — Guest Role (no create permission)
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Guest Role — Limited Permissions', () => {

    // Switch to GUEST role for all tests in this block
    test.use({ role: Role.GUEST });

    test(
      `${Tags.REGRESSION} ${Tags.GUEST} Guest cannot see "New Submission" button`,

      async ({ dashboardPage }) => {
        await dashboardPage.navigate();
        // Guest should NOT see the "+ New Submission" button
        await dashboardPage.assertNewSubmissionButtonHidden();
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.GUEST} Guest can VIEW an existing submission but cannot change status`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        // Guest can still NAVIGATE to a submission
        await submissionOverview.navigateByUrl(stored.submissionUrl);
        await submissionOverview.verifyPageLoaded();

        // Guest can SEE the overview (read-only)
        await submissionOverview.assertNamedInsured(stored.namedInsured);

        // Guest sees Status as read-only — the dropdown should be disabled
        await expect(
          submissionOverview['statusDropdown'],
          'Status dropdown should be disabled for Guest role'
        ).toBeDisabled();
      }
    );
  });
});

