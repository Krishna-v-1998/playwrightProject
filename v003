        // Navigate authenticatedPage to the stored submission
        await submissionOverview.navigateByUrl(stored.submissionUrl);
        await submissionOverview.verifyPageLoaded();

        // Click sidebar → tab (this navigates authenticatedPage)
        await submissionOverview.clickInsuredInformationTab();

        // insuredInfoPage is already on the right page — same authenticatedPage
        await insuredInfoPage.verifyPageLoaded();
        await insuredInfoPage.assertNamedInsured(stored.namedInsured);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.INSURED} Can update Named Insured and value saves`,

      async ({ submissionOverview, insuredInfoPage }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await submissionOverview.navigateByUrl(stored.submissionUrl);
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.clickInsuredInformationTab();

        // Use the fixture — no new object
        await insuredInfoPage.verifyPageLoaded();
        await insuredInfoPage.fillNamedInsured('UPDATED-Company 999');
        await insuredInfoPage.assertNamedInsured('UPDATED-Company 999');
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.INSURED} Country change to Canada updates state list`,

      async ({ submissionOverview, insuredInfoPage }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await submissionOverview.navigateByUrl(stored.submissionUrl);
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.clickInsuredInformationTab();

        await insuredInfoPage.verifyPageLoaded();

        // DropdownComponent.select() handles this cleanly
        await insuredInfoPage.selectCountry('Canada');
        await insuredInfoPage.assertCountry('Canada');

        await insuredInfoPage.selectState('Ontario');
        await insuredInfoPage.assertState('Ontario');
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.INSURED} Required field error appears when Named Insured cleared`,

      async ({ submissionOverview, insuredInfoPage }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await submissionOverview.navigateByUrl(stored.submissionUrl);
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.clickInsuredInformationTab();

        await insuredInfoPage.verifyPageLoaded();
        await insuredInfoPage.fillNamedInsured('');
        await insuredInfoPage.assertNamedInsuredRequired();
      }
    );
  });

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 3 — Guest Role
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Guest Role', () => {

    test.use({ role: Role.GUEST });

    test(
      `${Tags.REGRESSION} ${Tags.GUEST} Insured fields are disabled for Guest`,

      async ({ submissionOverview, insuredInfoPage }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await submissionOverview.navigateByUrl(stored.submissionUrl);
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.clickInsuredInformationTab();

        await insuredInfoPage.verifyPageLoaded();
        await expect(insuredInfoPage['firstNamedInsuredInput']).toBeDisabled();
      }
    );
  });
});

