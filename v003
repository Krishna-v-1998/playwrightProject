import { Page, Locator, expect } from '@playwright/test';
import { BasePage }               from './base/BasePage';
import { SubmissionFormData }     from '../types/submission.types';
import { DateHelper }             from '../helpers/DateHelper';
import { AssertionUtils }         from '../utils/AssertionUtils';

/**
 * PolicyInformationPage
 *
 * ── WHAT THIS IS ──────────────────────────────────────────────────────────────
 * This handles the "Policy Information" tab inside General Information.
 *
 * Think of it as the second tab where you see/edit the policy-specific details:
 *   - What policy number has been assigned
 *   - When the policy starts and ends
 *   - What products were selected
 *   - What sub-segments apply
 *   - The underwriter's notes about the policy
 *
 * ── HOW TO GET HERE ───────────────────────────────────────────────────────────
 *   const overview    = new SubmissionOverviewPage(submissionTab);
 *   await overview.clickPolicyInformationTab();
 *   const policyPage  = new PolicyInformationPage(submissionTab);
 *
 * ── WHAT YOU SEE ON SCREEN ────────────────────────────────────────────────────
 *   POLICY NUMBER              [max 14 alphanumeric chars]
 *   SUBMISSION NUMBER          [auto-filled, e.g. 4061442121]
 *   INCEPTION DATE             [09/08/2026]
 *   EXPIRATION DATE            [09/08/2027]  ← auto-calculated (1 year)
 *   REQUESTED DATE             [MM/DD/YYYY]  ← optional
 *   PRODUCT                    [multi-select dropdown]
 *   POLICY TYPE                [New / Renewal]  ← read-only on this page
 *   SUB SEGMENT                [multi-select, 4 options]
 *   UNDERWRITING RATIONALE     [rich text editor]
 *   PY PRICING SUMMARY button  [only appears if Policy Type = Renewal]
 *
 * ── SETUP REQUIRED ────────────────────────────────────────────────────────────
 * Replace all YOUR_*_SELECTOR with actual selectors.
 */
export class PolicyInformationPage extends BasePage {

  // ── Page Ready Indicator ───────────────────────────────────────────────────
  // We wait for the Submission Number field to appear — it's always visible
  // and always auto-filled, so it confirms the tab has loaded properly.
  private readonly submissionNumberInput:    Locator;

  // ── Policy Number ──────────────────────────────────────────────────────────
  // Business Rule: max 14 alphanumeric characters
  private readonly policyNumberInput:        Locator;
  private readonly policyNumberError:        Locator;

  // ── Date Fields ────────────────────────────────────────────────────────────
  private readonly inceptionDateInput:       Locator;
  private readonly expirationDateInput:      Locator;
  private readonly requestedDateInput:       Locator;

  // ── Product Multi-Select ───────────────────────────────────────────────────
  // Products is a multi-select — you can pick more than one
  private readonly productContainer:         Locator;

  // ── Policy Type ────────────────────────────────────────────────────────────
  // Read-only display — shows 'New' or 'Renewal'
  private readonly policyTypeDisplay:        Locator;

  // ── Sub Segment Multi-Select ───────────────────────────────────────────────
  // Sub Segment has 4 options — user can select multiple
  private readonly subSegmentContainer:      Locator;

  // ── Underwriting Rationale ─────────────────────────────────────────────────
  // Rich text editor — like a small word processor inside the form
  // Users type notes about why they're underwriting this policy
  private readonly uwRationaleEditor:        Locator;

  // ── Renewal-Only Button ────────────────────────────────────────────────────
  // Only visible when Policy Type = Renewal
  private readonly pyPricingSummaryButton:   Locator;

  constructor(page: Page) {
    super(page);

    this.submissionNumberInput  = page.locator('YOUR_POLICY_SUBMISSION_NUMBER_INPUT');
    this.policyNumberInput      = page.locator('YOUR_POLICY_NUMBER_INPUT');
    this.policyNumberError      = page.locator('YOUR_POLICY_NUMBER_ERROR_SELECTOR');
    this.inceptionDateInput     = page.locator('YOUR_POLICY_INCEPTION_DATE_INPUT');
    this.expirationDateInput    = page.locator('YOUR_POLICY_EXPIRATION_DATE_INPUT');
    this.requestedDateInput     = page.locator('YOUR_POLICY_REQUESTED_DATE_INPUT');
    this.productContainer       = page.locator('YOUR_POLICY_PRODUCT_CONTAINER');
    this.policyTypeDisplay      = page.locator('YOUR_POLICY_TYPE_DISPLAY_SELECTOR');
    this.subSegmentContainer    = page.locator('YOUR_POLICY_SUB_SEGMENT_CONTAINER');
    this.uwRationaleEditor      = page.locator('YOUR_UW_RATIONALE_EDITOR_SELECTOR');
    this.pyPricingSummaryButton = page.locator('YOUR_PY_PRICING_SUMMARY_BTN_SELECTOR');
  }

  // ── Page Load Check ────────────────────────────────────────────────────────

  /**
   * HOW THIS WORKS (simple explanation):
   *   1. waitForLoadState('networkidle') — browser stops all background calls
   *      Like: the page has stopped "thinking" in the background
   *   2. submissionNumberInput.waitFor('visible') — the form field appeared
   *      Like: you can now see the Submission Number field on screen
   *
   * We use the Submission Number field because it's:
   *   - Always present on this tab
   *   - Always auto-filled (so we know data loaded)
   *   - Shows up early in the page load
   */
  async verifyPageLoaded(): Promise<void> {
    await this.page.waitForLoadState('networkidle');

    await this.submissionNumberInput.waitFor({
      state:   'visible',
      timeout: 15_000,
    });

    this.log('Policy Information tab loaded');
  }

  async getPageTitle(): Promise<string> { return this.page.title(); }

  // ── Read Field Values ──────────────────────────────────────────────────────

  async getSubmissionNumber(): Promise<string> {
    return (await this.submissionNumberInput.inputValue()).trim();
  }

  async getPolicyNumber(): Promise<string> {
    return (await this.policyNumberInput.inputValue()).trim();
  }

  async getInceptionDate(): Promise<string> {
    return (await this.inceptionDateInput.inputValue()).trim();
  }

  async getExpirationDate(): Promise<string> {
    return (await this.expirationDateInput.inputValue()).trim();
  }

  async getPolicyType(): Promise<string> {
    return (await this.policyTypeDisplay.innerText()).trim();
  }

  // ── Fill / Update Field Values ─────────────────────────────────────────────

  /**
   * Fills the Policy Number field.
   *
   * BUSINESS RULE: Maximum 14 alphanumeric characters.
   * If you type more than 14, the application shows an error.
   *
   * EXAMPLE:
   *   await policyPage.fillPolicyNumber('POL-2026-001');  ← valid (12 chars)
   *   await policyPage.fillPolicyNumber('ABCD1234ABCD123'); ← invalid (15 chars → shows error)
   */
  async fillPolicyNumber(value: string): Promise<void> {
    await this.policyNumberInput.clear();
    await this.policyNumberInput.fill(value);
    await this.policyNumberInput.press('Tab'); // triggers validation
    this.log(`Filled Policy Number: ${value}`);
  }

  async fillInceptionDate(date: string): Promise<void> {
    // Clear and type the date, then press Tab to trigger
    // the Expiration Date auto-calculation (1 year after inception)
    await this.inceptionDateInput.click();
    await this.inceptionDateInput.fill(date);
    await this.inceptionDateInput.press('Tab');
    this.log(`Filled Inception Date: ${date}`);
  }

  async fillExpirationDate(date: string): Promise<void> {
    await this.expirationDateInput.click();
    await this.expirationDateInput.fill(date);
    await this.expirationDateInput.press('Tab');
    this.log(`Filled Expiration Date: ${date}`);
  }

  async fillRequestedDate(date: string): Promise<void> {
    await this.requestedDateInput.click();
    await this.requestedDateInput.fill(date);
    await this.requestedDateInput.press('Tab');
  }

  async fillUnderwritingRationale(text: string): Promise<void> {
    // Rich text editors don't use .fill() — you click inside then type
    await this.uwRationaleEditor.click();
    await this.uwRationaleEditor.fill(text);
    this.log(`Filled UW Rationale (${text.length} chars)`);
  }

  async clearUnderwritingRationale(): Promise<void> {
    await this.uwRationaleEditor.click();
    // Select All + Delete = clear all text
    await this.uwRationaleEditor.press('Control+a');
    await this.uwRationaleEditor.press('Delete');
    this.log('Cleared UW Rationale');
  }

  // ── Assert Field Values ────────────────────────────────────────────────────

  async assertSubmissionNumber(expected: string): Promise<void> {
    await expect(
      this.submissionNumberInput,
      `Submission Number should be "${expected}"`
    ).toHaveValue(expected);
    this.log(`✅ Submission Number: ${expected}`);
  }

  async assertPolicyNumber(expected: string): Promise<void> {
    await expect(
      this.policyNumberInput,
      `Policy Number should be "${expected}"`
    ).toHaveValue(expected);
    this.log(`✅ Policy Number: ${expected}`);
  }

  async assertInceptionDate(expected: string): Promise<void> {
    await expect(
      this.inceptionDateInput,
      `Inception Date should be "${expected}"`
    ).toHaveValue(expected);
    this.log(`✅ Inception Date: ${expected}`);
  }

  async assertExpirationDate(expected: string): Promise<void> {
    await expect(
      this.expirationDateInput,
      `Expiration Date should be "${expected}"`
    ).toHaveValue(expected);
    this.log(`✅ Expiration Date: ${expected}`);
  }

  async assertExpirationAutoCalculated(inceptionDate: string): Promise<void> {
    // Business Rule: Expiration = Inception + 1 year
    const expectedExpiry = DateHelper.calculateExpirationDate(inceptionDate);
    await this.assertExpirationDate(expectedExpiry);
    this.log(`✅ Expiration auto-calculated: ${expectedExpiry}`);
  }

  async assertPolicyType(expected: 'New' | 'Renewal'): Promise<void> {
    await expect(
      this.policyTypeDisplay,
      `Policy Type should be "${expected}"`
    ).toContainText(expected);
    this.log(`✅ Policy Type: ${expected}`);
  }

  // ── Policy Number Validation ───────────────────────────────────────────────

  async assertPolicyNumberAccepts14Chars(): Promise<void> {
    const exactly14 = 'ABCD1234ABCD12'; // 14 characters — valid
    await this.fillPolicyNumber(exactly14);
    await expect(
      this.policyNumberError,
      'No error should appear for 14 characters'
    ).toBeHidden();
    this.log('✅ Policy Number accepts exactly 14 chars');
  }

  async assertPolicyNumberRejectsOver14Chars(): Promise<void> {
    const over14 = 'ABCD1234ABCD123'; // 15 characters — too long
    await this.fillPolicyNumber(over14);
    await expect(
      this.policyNumberError,
      'Error should appear for more than 14 characters'
    ).toBeVisible();
    this.log('✅ Policy Number rejects 15+ chars');
  }

  // ── Renewal Policy Specific ────────────────────────────────────────────────

  /**
   * Business Rule: If Policy Type = Renewal, the PY Pricing Summary button appears.
   * This button is used to view pricing from the previous year.
   */
  async assertPYPricingSummaryVisible(): Promise<void> {
    await expect(
      this.pyPricingSummaryButton,
      'PY Pricing Summary button should be visible for Renewal'
    ).toBeVisible();
    this.log('✅ PY Pricing Summary button visible (Renewal)');
  }

  async assertPYPricingSummaryHidden(): Promise<void> {
    await expect(
      this.pyPricingSummaryButton,
      'PY Pricing Summary button should NOT be visible for New policy'
    ).toBeHidden();
    this.log('✅ PY Pricing Summary button hidden (New policy)');
  }

  // ── Combined: Verify auto-population from submission ──────────────────────

  async assertAutoPopulatedFromSubmission(data: SubmissionFormData): Promise<void> {
    this.log('--- Verifying Policy Information auto-population ---');

    await this.assertSubmissionNumber(data.submissionNumber);
    await this.assertInceptionDate(data.inceptionDate);

    // Expiration date: use provided value or auto-calculate from inception
    const expectedExpiry = data.expirationDate
      ?? DateHelper.calculateExpirationDate(data.inceptionDate);
    await this.assertExpirationDate(expectedExpiry);

    await this.assertPolicyType(data.policyType);

    // Check Renewal-specific button
    if (data.policyType === 'Renewal') {
      await this.assertPYPricingSummaryVisible();
    } else {
      await this.assertPYPricingSummaryHidden();
    }

    this.log('--- Policy Information verified ✅ ---');
  }
}

