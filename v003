      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        const { policyPage } = await openStoredPolicyTab(submissionOverview);
        await policyPage.assertSubmissionNumber(stored.submissionNumber);
