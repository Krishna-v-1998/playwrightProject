test.use({ role: Role.UW });

test.describe('Insured Information Tab — Validation', () => {

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 1 — Create submission → verify Insured tab on the NEW TAB
  //
  // Must create new objects because newTab ≠ authenticatedPage (the fixture's tab)
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Auto-population after creation', () => {

    test.beforeEach(async ({ dashboardPage }) => {
      await dashboardPage.navigate();
    });

    test(
      `${Tags.SMOKE} ${Tags.INSURED} All insured fields auto-populated from modal data`,

