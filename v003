        await policyPage.assertInceptionDate(data.inceptionDate);
      }
    );

    test(
      `${Tags.SANITY} ${Tags.POLICY} Expiration Date auto-calculated as Inception + 1 year`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const { data, policyPage } = await createAndNavigateToPolicyTab(
          dashboardPage, newSubmissionModal, authenticatedPage,
        );

        // Business Rule: Expiration = Inception + 1 year (auto-calculated)
        // E.g.: Inception = 09/08/2026 → Expiration = 09/08/2027
        await policyPage.assertExpirationAutoCalculated(data.inceptionDate);
      }
    );

    test(
      `${Tags.SANITY} ${Tags.POLICY} Policy Type matches what was selected in modal`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const { data, policyPage } = await createAndNavigateToPolicyTab(
          dashboardPage, newSubmissionModal, authenticatedPage,
