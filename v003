import { test, expect }              from '../../src/fixtures/index';
import { Tags }                      from '../../src/constants/test-tags.constants';
import { Role }                      from '../../src/enums/role.enum';
import { SubmissionFactory }         from '../../src/data/factories/SubmissionFactory';
import { SubmissionManager }         from '../../src/data/managers/SubmissionManager';
import { SubmissionOverviewPage }    from '../../src/pages/SubmissionOverviewPage';
import { InsuredInformationPage }    from '../../src/pages/InsuredInformationPage';

/**
 * insured-information.spec.ts
 *
 * ── WHAT WE ARE TESTING ───────────────────────────────────────────────────────
 * The "Insured Information" tab inside General Information.
 *
 * MOST IMPORTANT THING:
 *   When a submission is created in the New Submission Modal,
 *   ALL the insured fields (name, address, country etc.) are auto-filled here.
 *   We verify that what we typed in the modal = what appears in this tab.
 *
 * ── HOW TO GET TO THIS TAB ───────────────────────────────────────────────────
 *   1. Open submission (new tab opens automatically)
 *   2. Click "General Information" in the left sidebar
 *   3. "Insured Information" tab is active by default (first tab)
 *
 * ── NAVIGATION PATTERN IN TESTS ──────────────────────────────────────────────
 *   Create submission → new tab
 *     → overview.clickInsuredInformationTab()   ← sidebar + tab click
 *       → new InsuredInformationPage(newTab)    ← SAME page reference
 *         → verifyPageLoaded()
 *           → assert fields match creation data
 */

test.use({ role: Role.UW });

test.describe('Insured Information Tab — Field Validation', () => {

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 1 — Create submission → immediately verify Insured Information tab
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Immediate validation after submission creation', () => {

    test.beforeEach(async ({ dashboardPage }) => {
      await dashboardPage.navigate();
    });

    // ── Helper function ─────────────────────────────────────────────────────
    // We create submissions and navigate to Insured Info in many tests.
    // This helper does the repetitive steps so each test is clean and short.
    //
    // WHAT THIS DOES:
    //   Creates submission → opens new tab → navigates to Insured Info tab
    //   Returns the InsuredInformationPage object ready to use.

    async function createAndNavigateToInsuredTab(
      dashboardPage:    any,
      newSubmissionModal: any,
      authenticatedPage: any,
      factory:          () => any = SubmissionFactory.default,
    ) {
      const data   = factory();
      await dashboardPage.clickNewSubmission();
      await newSubmissionModal.verifyPageLoaded();

      // Creates submission, waits for new tab to open, returns the new tab
      const newTab = await newSubmissionModal.createSubmission(
        data,
        authenticatedPage.context(),
      );

      // STEP 1: Create SubmissionOverviewPage on the new tab
      const overviewPage = new SubmissionOverviewPage(newTab);
      await overviewPage.verifyPageLoaded();

      // STEP 2: Click General Information in sidebar → then Insured Info tab
      await overviewPage.clickInsuredInformationTab();

      // STEP 3: Create InsuredInformationPage on the SAME new tab
      // This is important: same newTab reference, not a new page
      const insuredPage = new InsuredInformationPage(newTab);
      await insuredPage.verifyPageLoaded();

      return { data, insuredPage, overviewPage, newTab };
    }

    // ── SMOKE TEST ──────────────────────────────────────────────────────────

    test(
      `${Tags.SMOKE} ${Tags.INSURED} `
      + 'All insured fields auto-populated from New Submission Modal data',

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const { data, insuredPage } = await createAndNavigateToInsuredTab(
          dashboardPage, newSubmissionModal, authenticatedPage,
        );

        // This ONE call checks ALL fields at once:
        //   Named Insured, Country, Street, City, State, Zip, Street2
        // All should match exactly what was entered in the New Submission Modal
        await insuredPage.assertAutoPopulatedFromSubmission(data);
      }
    );

    // ── INDIVIDUAL FIELD TESTS ──────────────────────────────────────────────

    test(
      `${Tags.SANITY} ${Tags.INSURED} First Named Insured matches modal entry`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const { data, insuredPage } = await createAndNavigateToInsuredTab(
          dashboardPage, newSubmissionModal, authenticatedPage,
        );

        // The company name we typed in the modal = the value in this field
        await insuredPage.assertNamedInsured(data.insured.namedInsured);
      }
    );

    test(
      `${Tags.SANITY} ${Tags.INSURED} Country defaults to USA and matches modal entry`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const { data, insuredPage } = await createAndNavigateToInsuredTab(
          dashboardPage, newSubmissionModal, authenticatedPage,
        );

        // Default country in modal is USA — should carry over here
        await insuredPage.assertCountry(data.insured.country);
      }
    );

    test(
      `${Tags.SANITY} ${Tags.INSURED} Street Address matches modal entry`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const { data, insuredPage } = await createAndNavigateToInsuredTab(
          dashboardPage, newSubmissionModal, authenticatedPage,
        );

        await insuredPage.assertStreetAddress(data.insured.streetAddress);
      }
    );

    test(
      `${Tags.SANITY} ${Tags.INSURED} City, State and Zip match modal entries`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const { data, insuredPage } = await createAndNavigateToInsuredTab(
          dashboardPage, newSubmissionModal, authenticatedPage,
        );

        await insuredPage.assertCity(data.insured.city);
        await insuredPage.assertState(data.insured.state);
        await insuredPage.assertZip(data.insured.zip);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.INSURED} "+ Add Named Insured" button is visible`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const { insuredPage } = await createAndNavigateToInsuredTab(
          dashboardPage, newSubmissionModal, authenticatedPage,
        );

        // This button lets users add more named insureds (co-insureds)
        await insuredPage.assertAddNamedInsuredButtonVisible();
      }
    );

    // ── EDITING TESTS ───────────────────────────────────────────────────────

    test(
      `${Tags.REGRESSION} ${Tags.INSURED} Can update Named Insured and value is saved`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const { insuredPage } = await createAndNavigateToInsuredTab(
          dashboardPage, newSubmissionModal, authenticatedPage,
        );

        const updatedName = 'UPDATED-Company Name 999';

        // Type the new name → Tab key triggers auto-save
        await insuredPage.fillNamedInsured(updatedName);

        // After auto-save, verify the new name stuck
        await insuredPage.assertNamedInsured(updatedName);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.INSURED} Country change to Canada updates state list to provinces`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const { insuredPage } = await createAndNavigateToInsuredTab(
          dashboardPage, newSubmissionModal, authenticatedPage,
        );

        // Change country to Canada
        await insuredPage.selectCountry('Canada');
        await insuredPage.assertCountry('Canada');

        // State/Province list should now show Canadian provinces
        // Wait for the state list to reload after country change
        // Then select a province
        await insuredPage.selectState('Ontario');
        await insuredPage.assertState('Ontario');
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.INSURED} Can update all address fields and they save correctly`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const { insuredPage } = await createAndNavigateToInsuredTab(
          dashboardPage, newSubmissionModal, authenticatedPage,
        );

        // Update each address field
        await insuredPage.fillStreetAddress('999 Updated Street');
        await insuredPage.fillCity('Los Angeles');
        await insuredPage.fillZip('90210');

        // Verify all updates were saved
        await insuredPage.assertStreetAddress('999 Updated Street');
        await insuredPage.assertCity('Los Angeles');
        await insuredPage.assertZip('90210');
      }
    );

    // ── CANADIAN ADDRESS VARIANT ────────────────────────────────────────────

    test(
      `${Tags.REGRESSION} ${Tags.INSURED} Canadian submission — address fields auto-populated`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        // SubmissionFactory.withCanadianAddress() creates data with Country = Canada
        const { data, insuredPage } = await createAndNavigateToInsuredTab(
          dashboardPage, newSubmissionModal, authenticatedPage,
          SubmissionFactory.withCanadianAddress,
        );

        await insuredPage.assertCountry('Canada');
        await insuredPage.assertState(data.insured.state);   // e.g. 'Ontario'
        await insuredPage.assertZip(data.insured.zip);       // e.g. 'M5H 2N2'
      }
    );
  });

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 2 — Navigate to stored submission and verify Insured Info tab
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Direct navigation using stored submission', () => {

    // Helper: Navigate to insured tab on the stored submission
    async function openStoredInsuredTab(submissionOverview: SubmissionOverviewPage) {
      const stored = SubmissionManager.getLatest();

      if (!stored) {
        throw new Error(
          'No stored submission found.\n' +
          'Run: npx playwright test tests/submission/new-submission.spec.ts first.'
        );
      }

      // Navigate to the stored submission using its full URL
      await submissionOverview.navigateByUrl(stored.submissionUrl);
      await submissionOverview.verifyPageLoaded();

      // Click General Information → Insured Information tab
      await submissionOverview.clickInsuredInformationTab();

      // Create InsuredInformationPage on the SAME page
      const insuredPage = new InsuredInformationPage(submissionOverview['page']);
      await insuredPage.verifyPageLoaded();

      return { insuredPage, stored };
    }

    test(
      `${Tags.REGRESSION} ${Tags.INSURED} Stored submission Named Insured matches stored value`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        const { insuredPage } = await openStoredInsuredTab(submissionOverview);
        await insuredPage.assertNamedInsured(stored.namedInsured);
      }
    );

    test(
      `${Tags.REGRESSION} ${Tags.INSURED} Required fields show error when cleared`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        const { insuredPage } = await openStoredInsuredTab(submissionOverview);

        // Clear the required Named Insured field and move focus away
        await insuredPage.fillNamedInsured(''); // clear it
        await insuredPage.assertNamedInsuredRequired(); // error should appear
      }
    );
  });

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 3 — Guest Role
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Guest Role — All Fields Read-Only', () => {

    test.use({ role: Role.GUEST });

    test(
      `${Tags.REGRESSION} ${Tags.GUEST} ${Tags.INSURED} Guest sees fields as read-only`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await submissionOverview.navigateByUrl(stored.submissionUrl);
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.clickInsuredInformationTab();

        const insuredPage = new InsuredInformationPage(submissionOverview['page']);
        await insuredPage.verifyPageLoaded();

        // Guest should see data but NOT be able to edit it
        // The Named Insured input should be disabled for Guest role
