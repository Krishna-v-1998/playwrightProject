  });

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 3 — Guest Role
  // ══════════════════════════════════════════════════════════════════════════

  test.describe('Guest Role — Read-Only', () => {

    test.use({ role: Role.GUEST });

    test(
      `${Tags.REGRESSION} ${Tags.GUEST} ${Tags.POLICY} Policy Number is disabled for Guest`,

      async ({ submissionOverview }) => {

        const stored = SubmissionManager.getLatest();
        if (!stored) { test.skip(true, 'No stored submission.'); return; }

        await submissionOverview.navigateByUrl(stored.submissionUrl);
        await submissionOverview.verifyPageLoaded();
        await submissionOverview.clickPolicyInformationTab();

        const policyPage = new PolicyInformationPage(submissionOverview['page']);
        await policyPage.verifyPageLoaded();

        // Guest cannot edit the policy number
        await expect(
          policyPage['policyNumberInput'],
          'Policy Number should be read-only for Guest'
        ).toBeDisabled();
      }
    );
  });
});
