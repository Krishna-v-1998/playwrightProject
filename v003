 *   - Policy Type (New / Renewal)
 *   - Sub Segment (multi-select)
 *   - PY Pricing Summary button (only for Renewal)
 *   - Underwriting Rationale (rich text)
 *
 * CRITICAL BUSINESS RULE:
 *   Policy Number = max 14 alphanumeric characters
 *   If you type more than 14, the app shows a validation error
 */

test.use({ role: Role.UW });

test.describe('Policy Information Tab — Field Validation', () => {

  // ══════════════════════════════════════════════════════════════════════════
  // GROUP 1 — Create submission → immediately verify Policy Information
  // ══════════════════════════════════════════════════════════════════════════

