    test(
      `${Tags.SMOKE} ${Tags.POLICY} `
      + 'All policy fields auto-populated from New Submission Modal data',

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const { data, policyPage } = await createAndNavigateToPolicyTab(
          dashboardPage, newSubmissionModal, authenticatedPage,
        );

        // Checks: Submission Number, Inception Date, Expiration Date, Policy Type
        await policyPage.assertAutoPopulatedFromSubmission(data);
      }
