    test(
      `${Tags.SANITY} ${Tags.INSURED} Country, City, State and Zip match modal entries`,

      async ({ dashboardPage, newSubmissionModal, authenticatedPage }) => {

        const data   = SubmissionFactory.default();
        await dashboardPage.clickNewSubmission();
